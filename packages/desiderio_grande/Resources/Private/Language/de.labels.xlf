    <!-- Teamgruppe. Ein Band mit Personen erzeugt Reihen gleichlautender
         Links — sechs Schaltflächen mit denselben drei Wörtern. Die
         wiederkehrende Beschriftung steht deshalb hier, und der Name, der sie
         unterscheidet, kommt pro Zeile als Text dazu, den nur der Screenreader
         vorliest. -->
    <unit id="team.requestSession">
      <segment state="final">
        <source>Request a session</source>
        <target>Termin anfragen</target>
      </segment>
    </unit>

    <!-- Conversion-Gruppe. Das einzige Bedienelement der Gruppe ohne
         Redaktionsfeld dahinter: der Schließen-Knopf am schließbaren
         Angebotsband. Sein Name ist echter Text statt eines aria-label und
         wird deshalb mit allem anderen auf der Seite übersetzt. -->
    <unit id="conversion.dismiss">
      <segment state="final">
        <source>Close</source>
        <target>Schließen</target>
      </segment>
