# Desiderio Grande — the Astryx layer over Desiderio's rendering machinery.
#
# This set depends on webconsulting/desiderio, so by the time it is parsed the
# PAGE object, lib.fluidPage (PAGEVIEW), the data processors and the element
# library preview page all exist. What follows replaces the visible layer:
# stylesheets, script, favicon, body attributes and template paths.

# ---------------------------------------------------------------- stylesheets
# Desiderio's shadcn theme and component CSS would fight Astryx's tokens for the
# same elements, so the inherited list goes and ours takes its place.
page.includeCSS >
page.includeCSS {
  # 1. Tokens: the seven themes as custom-property overrides, every colour a
  #    light-dark() pair. Generated from the upstream theme sources by
  #    Build/Scripts/build-astryx-theme.mjs.
  astryxTheme = EXT:desiderio_grande/Resources/Public/Css/astryx-theme.css

  # 2. Components: the Astryx component styles, written against the same stable
  #    .astryx-* class names the upstream themes target, so a theme's component
  #    overrides land on our markup unchanged.
  grandeComponents = EXT:desiderio_grande/Resources/Public/Css/grande-components.css

  # 3. Chrome: fonts, base typography, header, footer, system pages.
  grandeBase = EXT:desiderio_grande/Resources/Public/Css/grande.css
}

# ------------------------------------------------------------------- scripts
# One small bundle, wired by data-g-* attributes. Everything that native HTML
# can do (disclosure, dialog, popover, scroll-snap) is done without it.
page.includeJSFooter >
page.includeJSFooter.grande = EXT:desiderio_grande/Resources/Public/Js/grande.js
page.includeJSFooter.grande.defer = 1

# ------------------------------------------------------------------- favicon
page.shortcutIcon = EXT:desiderio_grande/Resources/Public/Favicons/favicon.svg
# Desiderio's PNG favicon COA points at its own files.
page.headerData.2620 >

# --------------------------------------------------------------- body attrs
# data-astryx-theme selects the theme; the generated stylesheet scopes each
# theme's tokens to it. Precedence: page field (inherited down the rootline via
# levelfield slide) → site setting.
#
# data-color-scheme is only the server's opening bid: the no-FOUC script below
# promotes a stored visitor preference to a class on <html> before first paint,
# and light-dark() resolves against that.
page.bodyTagCObject >
page.bodyTagCObject = COA
page.bodyTagCObject {
  10 = TEXT
  10.value = <body data-color-scheme="{$desiderioGrande.theme.colorScheme}" data-astryx-theme="

  20 = TEXT
  20 {
    data = levelfield:-1, tx_desideriogrande_theme, slide
    htmlSpecialChars = 1
    ifEmpty = {$desiderioGrande.theme.default}
  }

  30 = TEXT
  30.value = ">
}

# ------------------------------------------------------- colour scheme boot
# Applies a stored preference before the first paint, so a visitor who chose
# dark never sees a white flash. It only sets a class: html.light / html.dark
# carry the color-scheme declaration, and "system" deliberately sets none, so
# :root's `color-scheme: light dark` follows the operating system. That is what
# every light-dark() token in the theme resolves against.
#
# Kept inline and minimal for the timing; the toggle button lives in grande.js.
page.headerData.2610 = TEXT
page.headerData.2610.value (
<script>(function(){try{var v=localStorage.getItem('g-scheme');var s=(v==='dark'||v==='light'||v==='system')?v:'{$desiderioGrande.theme.colorScheme}';if(s==='dark'||s==='light'){document.documentElement.classList.add(s);}}catch(e){}})();</script>
)

# ------------------------------------------------------------ template paths
# Higher index wins in a PAGEVIEW path stack. Desiderio's paths stay below as a
# fallback; every page template this theme renders lives here, and the backend
# layouts are named Grande* so they can only resolve from this directory.
lib.fluidPage.paths.50 = EXT:desiderio_grande/Resources/Private/Templates/
page.10.paths.50 = EXT:desiderio_grande/Resources/Private/Templates/

# ------------------------------------------------------------ picker preview
# The element library renders single elements through this page type. It copied
# Desiderio's assets when its own set was parsed, so re-copy ours over them —
# otherwise every preview thumbnail would be painted with the other theme.
elementLibraryPreview {
  includeCSS >
  includeCSS < page.includeCSS
  includeJSFooter >
  includeJSFooter < page.includeJSFooter
  bodyTagCObject >
  bodyTagCObject < page.bodyTagCObject
  shortcutIcon < page.shortcutIcon
  headerData.2610 < page.headerData.2610
  headerData.2620 >
}

# ------------------------------------------------ page tree for four elements
# Four navigation elements are derived from the page tree rather than from a
# curated list, which is the whole point of them: a sitemap or a path that an
# editor maintains by hand is a sitemap or a path that goes stale.
#
# lib.desiderioPageDataProcessing puts those menus on lib.fluidPage, so they
# reach page TEMPLATES. A content element renders through lib.contentBlock,
# which runs one processor and hands the template its own record and nothing
# else — mainMenu and breadcrumb never arrive there. Each of the four therefore
# gets the one menu it needs, under its own variable name, and the templates
# render nothing when the menu comes back empty.
tt_content.desiderio_grande_breadcrumbband.dataProcessing.20 = menu
tt_content.desiderio_grande_breadcrumbband.dataProcessing.20 {
  special = rootline
  as = trail
  # A page flagged "hide in menu" is still a page the reader is standing on;
  # dropping it would end the trail one step short of where they are.
  includeNotInMenu = 1
  titleField = nav_title // title
}

tt_content.desiderio_grande_sitemaptree.dataProcessing.20 = menu
tt_content.desiderio_grande_sitemaptree.dataProcessing.20 {
  special = directory
  special.value.data = page:uid
  as = sitemap
  levels = 2
  expandAll = 1
  titleField = nav_title // title
}

tt_content.desiderio_grande_siblingnav.dataProcessing.20 = menu
tt_content.desiderio_grande_siblingnav.dataProcessing.20 {
  special = directory
  special.value.data = page:pid
  as = siblings
  titleField = nav_title // title
}

# Only for the fallback: the element links wherever the editor points it, and
# reaches for the rootline solely when that field was left empty.
tt_content.desiderio_grande_backtoparent.dataProcessing.20 = menu
tt_content.desiderio_grande_backtoparent.dataProcessing.20 {
  special = rootline
  as = trail
  includeNotInMenu = 1
  titleField = nav_title // title
}

# The theme overview links to one detail page per theme. Those pages are the
# children of the Themes page, and they are nav_hide (twenty entries would
# swamp the main navigation), so the menu has to ask for hidden ones too.
#
# Real page records rather than paths built by hand: the overview partial is
# generated at build time, when no page uid exists yet, and a hardcoded
# /desiderio-grande/themes/<id>/ would break the moment the site moves.
[page["backend_layout"] == "pagets__GrandeThemes"]
  page.10.dataProcessing.910 = menu
  page.10.dataProcessing.910 {
    special = directory
    special.value.data = page:uid
    includeNotInMenu = 1
    as = themePages
    titleField = nav_title // title
  }
[END]
