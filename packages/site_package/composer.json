{
    "name": "webconsulting/site-package",
    "description": "Webconsulting TYPO3 Lab site package - shared Site Sets, editor defaults, Solr defaults, Admin Panel defaults, and Visual Editor Cowriter integration",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "apache-solr-for-typo3/solr": "dev-main",
        "friendsoftypo3/visual-editor": "^1.4",
        "georgringer/news": "^14.0",
        "studiomitte/solr-numbered-pagination": "dev-main",
        "t3g/blog": "dev-master",
        "typo3/cms-adminpanel": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/theme-camino": "^14.3",
        "webconsulting/desiderio": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^3.0.1",
        "typo3/testing-framework": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\SitePackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "site_package",
            "version": "14.0.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
