{
    "name": "webconsulting/site-package",
    "description": "Webconsulting TYPO3 Lab site package - shared Site Sets, Desiderio integration, editor defaults, Solr defaults, Admin Panel defaults, and Visual Editor Cowriter integration",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "apache-solr-for-typo3/solr": "^14.0@RC",
        "friendsoftypo3/tt-address": "^10.0",
        "friendsoftypo3/visual-editor": "^1.9",
        "georgringer/news": "^14.0",
        "netresearch/nr-llm": "^0.25",
        "netresearch/t3-cowriter": "^3.5",
        "php": "^8.4",
        "praetorius/vite-asset-collector": "^1.18",
        "studiomitte/solr-numbered-pagination": "dev-main",
        "t3g/blog": "^15.0",
        "typo3/cms-adminpanel": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "typo3/theme-camino": "^14.3",
        "webconsulting/desiderio": "^4.0"
    },
    "suggest": {
        "webconsulting/workos-auth": "Enables the optional Desiderio/shadcn WorkOS frontend plugin Site Set."
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^3.0.1"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\SitePackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "site_package",
            "version": "14.3.4",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
