        "_position": 1,
        "sys_language_uid": 0
      },
      "set": {
        "content": "<h3>Technical foundation</h3><ul><li><a href=\"https://netresearch.github.io/modularer-ki-stack-page/\">Modular AI stack · modules and requirements</a></li><li><a href=\"https://github.com/netresearch/t3x-nr-llm\">nr-llm · project and documentation</a></li><li><a href=\"https://github.com/netresearch/t3x-nr-llm/tree/5b6fca6de8d9593638486c0baca9424934bdc231\">nr-llm 0.43.19 · checked on 6 Nov 2026</a></li><li><a href=\"https://modelcontextprotocol.io/docs/2026-07-28/learn/architecture\">MCP · client and server architecture</a></li><li><a href=\"https://a2a-protocol.org/latest/topics/a2a-and-mcp/\">A2A and MCP · official positioning</a></li><li><a href=\"https://symfony.com/doc/current/ai/components/platform.html\">Symfony AI Platform · PHP foundation</a></li></ul>",
        "foreign_table_parent_uid": "@NEW_nrtalk_sources_s37",
        "sys_language_uid": 0,
        "hidden": 0
      }
    },
    {
      "table": "content_columns_items",
      "action": "create",
      "key": "NEW_nrtalk_sources_s37_1",
      "pid": "@NEW_nrtalk_page_sources",
      "match": {
        "pid": "@NEW_nrtalk_page_sources",
        "foreign_table_parent_uid": "@NEW_nrtalk_sources_s37",
        "_position": 2,
        "sys_language_uid": 0
      },
      "set": {
        "content": "<h3>AI layers and MCP servers</h3><ul><li><a href=\"https://github.com/b13/aim\">b13 AiM · TYPO3 AI layer</a></li><li><a href=\"https://docs.typo3.org/p/nitsan/ns-t3af/main/en-us/Index.html\">NITSAN / T3Planet · AI Foundation</a></li><li><a href=\"https://www.louis.info/leistungen/technologien/typo3-extensions/\">LOUIS INTERNET · LIA Middleware AI</a></li><li><a href=\"https://docs.typo3.org/p/madj2k/t3-ai-assistant/main/en-us/Introduction/ArchitectureOverview.html\">Madj2k AI Core + TYPO3 AI Assistant</a></li><li><a href=\"https://github.com/hauptsacheNet/typo3-mcp-server\">hauptsache.net · TYPO3 MCP Server</a></li><li><a href=\"https://github.com/marekskopal/typo3-mcp-server\">Marek Skopal · TYPO3 MCP Server</a></li><li><a href=\"https://github.com/autodudesde/ai-suite#mcp-server-optional-sub-extension\">AutoDudes · AI Suite MCP (add-on)</a></li></ul>",
        "foreign_table_parent_uid": "@NEW_nrtalk_sources_s37",
        "sys_language_uid": 0,
        "hidden": 0
      }
    },
