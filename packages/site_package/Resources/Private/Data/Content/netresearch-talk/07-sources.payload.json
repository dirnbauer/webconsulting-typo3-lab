        "sys_language_uid": 0
      },
      "set": {
        "content": "<h3>Netresearch demo backend (login required)</h3><ul><li><a href=\"https://typo3-demo.netresearch.de/typo3/record/edit?edit%5Btt_content%5D%5B30%5D=edit\">Open the editor</a> (slide 4)</li><li><a href=\"https://typo3-demo.netresearch.de/typo3/record/edit?edit%5Bpages%5D%5B9102%5D=edit\">Open page fields</a> (slide 4)</li><li><a href=\"https://typo3-demo.netresearch.de/typo3/module/web/nr-repurpose\">Open Repurpose</a> (slide 6)</li><li><a href=\"https://typo3-demo.netresearch.de/typo3/module/nr/mcp/agent/chat/conversation\">Open AI chat</a> (slide 7)</li><li><a href=\"https://typo3-demo.netresearch.de/extensions/browser-ai-form-assistant\">Form demo</a> (slide 9)</li><li><a href=\"https://typo3-demo.netresearch.de/typo3/module/nrllm/configurations\">Open configurations</a> (slide 15)</li><li><a href=\"https://typo3-demo.netresearch.de/typo3/module/nrllm/analytics\">Open cost overview</a> (slide 22)</li><li><a href=\"https://typo3-demo.netresearch.de/typo3/module/nrllm/tools\">Open tools</a> (slide 26)</li></ul>",
        "foreign_table_parent_uid": "@NEW_nrtalk_sources_all_links",
        "sys_language_uid": 0,
        "hidden": 0
      }
    },
    {
      "table": "content_columns_items",
