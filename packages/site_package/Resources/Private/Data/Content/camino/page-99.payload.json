            "uid": 1397,
            "expect": {
                "CType": "text",
                "header": "Start Your Camino",
                "bodytext": "<p>Whether you walk for a week or a month, alone or with friends, the Camino meets you exactly where you are. There is no right or wrong way to walk it — only your way.</p>\n<p>Buen Camino.&nbsp;<br />Your journey begins with a single step.</p>"
            },
            "set": {
