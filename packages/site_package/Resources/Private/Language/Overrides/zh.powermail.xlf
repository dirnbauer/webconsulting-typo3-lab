<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides EXT:powermail/Resources/Private/Language/locallang.xlf for the lab sites (site_package ext_localconf.php): labels the Desiderio templates show that the powermail extension or its language packs do not translate. -->
<xliff version="2.0" xmlns="urn:oasis:names:tc:xliff:document:2.0" srcLang="en" trgLang="zh">
  <file id="powermail-overrides">
    <unit id="error_no_form">
      <segment state="final">
        <source>No form to show</source>
        <target>没有可显示的表单</target>
      </segment>
    </unit>
    <unit id="confirmation_prev">
      <segment state="final">
        <source>Previous</source>
        <target>返回</target>
      </segment>
    </unit>
    <unit id="confirmation_submit">
      <segment state="final">
        <source>Submit</source>
        <target>提交</target>
      </segment>
    </unit>
    <unit id="optin_seeMail">
      <segment state="final">
        <source>Please have a look into your mail account and confirm this action.</source>
        <target>请查看您的邮箱并确认此操作。</target>
      </segment>
    </unit>
    <unit id="validationerror_title">
      <segment state="final">
        <source>There are errors in this form</source>
        <target>此表单中有错误</target>
      </segment>
    </unit>
    <unit id="validationerror_spam">
      <segment state="final">
        <source>Spam recognized:</source>
        <target>检测到垃圾信息：</target>
      </segment>
    </unit>
    <unit id="validationerror_container_label">
      <segment state="final">
        <source>Problematic form fields</source>
        <target>有问题的表单字段</target>
      </segment>
    </unit>
    <unit id="deleteAllFiles">
      <segment state="final">
        <source>Delete All Files</source>
        <target>删除所有文件</target>
      </segment>
    </unit>
    <unit id="honeypodLabel">
      <segment state="final">
        <source>Don't fill this field!</source>
        <target>请勿填写此字段。</target>
      </segment>
    </unit>
  </file>
</xliff>
