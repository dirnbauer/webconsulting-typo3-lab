# Render the Agent Stack frontend plugins (A2UI / AG-UI / A2A / UCP / AP2)
# through the site's content-element wrapper (lib.contentElement), so each one
# appears framed + styled like every other content element. The plugin's own
# output is the cObj "20" (EXTBASEPLUGIN); the generic AgentStackPlugin FSC
# template renders the element header + that plugin output.
lib.contentElement.templateRootPaths.250 = EXT:site_package/Resources/Private/FluidStyledContent/Templates/

tt_content.agentnexus_inquiry =< lib.contentElement
tt_content.agentnexus_inquiry {
    templateName = AgentStackPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = Inquiry
    }
}

tt_content.a2uiintegration_inquiry =< lib.contentElement
tt_content.a2uiintegration_inquiry {
    templateName = AgentStackPlugin
    20 = EXTBASEPLUGIN
    20 {
        extensionName = AgentNexus
        pluginName = Inquiry
    }
}

