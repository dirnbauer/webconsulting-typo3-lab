#
# Render the TYPO3 Admin Panel in the frontend for authenticated backend users.
#
config.admPanel = 1

plugin.tx_news.view.partialRootPaths.100 = EXT:desiderio/Resources/Private/Partials/
plugin.tx_blog.view.partialRootPaths.100 = EXT:desiderio/Resources/Private/Partials/

lib.contentElement.templateRootPaths.300 = EXT:site_package/Resources/Private/ClassicContent/Templates/
page.10.paths.100 = EXT:site_package/Resources/Private/Templates/

[site("identifier") == "desiderio"]
page.includeCSS.sitePackageDesiderioA11y = EXT:site_package/Resources/Public/Css/desiderio-a11y.css
page.includeCSS.sitePackageSystemPages = EXT:site_package/Resources/Public/Css/system-pages.css
page.includeJSFooter.sitePackageDesiderioPowermailA11y = EXT:site_package/Resources/Public/JavaScript/desiderio-powermail-a11y.js
page.includeJSFooter.sitePackageDesiderioPowermailA11y.defer = 1

plugin.tx_powermail.view.partialRootPaths.2000000 = EXT:site_package/Resources/Private/Extensions/Powermail/Partials/
[END]

[site("identifier") == "desiderio" && page["uid"] == 1149]
page.bodyTagAdd = class="technical-features-page"
[END]

[site("identifier") == "desiderio" && page["uid"] == 737]
page.bodyTagAdd = class="page-not-found"
[END]

# EXT:blog registers its plugins as CType-based Extbase content elements.
# Desiderio's ClassicContent wrapper needs to explicitly render the
# extension-provided tt_content.<CType>.20 plugin output for these CTypes.
tt_content.blog_posts.templateName = BlogPlugin
tt_content.blog_latestposts.templateName = BlogPlugin
tt_content.blog_category.templateName = BlogPlugin
tt_content.blog_authorposts.templateName = BlogPlugin
tt_content.blog_tag.templateName = BlogPlugin
tt_content.blog_archive.templateName = BlogPlugin
tt_content.blog_sidebar.templateName = BlogPlugin
tt_content.blog_commentform.templateName = BlogPlugin
tt_content.blog_comments.templateName = BlogPlugin
tt_content.blog_authors.templateName = BlogPlugin
tt_content.blog_demandedposts.templateName = BlogPlugin
tt_content.blog_relatedposts.templateName = BlogPlugin
tt_content.blog_header.templateName = BlogPlugin
tt_content.blog_footer.templateName = BlogPlugin
