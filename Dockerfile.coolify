# syntax=docker/dockerfile:1.7

ARG COMPOSER_VERSION=2.10.2
FROM composer:${COMPOSER_VERSION} AS composer-runtime
FROM node:24-bookworm-slim AS node-runtime
FROM php:8.4-apache-bookworm

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer \
    TYPO3_CONTEXT=Production

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install --no-install-recommends -y \
        apache2-utils \
        ca-certificates \
        curl \
        graphicsmagick \
        libfreetype6 \
        libicu72 \
        libjpeg62-turbo \
        libpng16-16 \
        libwebp7 \
        libxml2 \
        libzip4 \
    && apt-get install --no-install-recommends -y \
        git \
        libfreetype6-dev \
        libicu-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        libwebp-dev \
        libxml2-dev \
        libzip-dev \
        unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" gd intl mysqli opcache pdo_mysql soap zip \
    && a2enmod deflate expires headers remoteip rewrite setenvif \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer-runtime /usr/bin/composer /usr/local/bin/composer
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /var/www/html
COPY . .

RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --optimize-autoloader \
        --prefer-dist \
    && npm ci --ignore-scripts \
    && npm run build \
    && apt-get purge -y --auto-remove \
        git \
        libfreetype6-dev \
        libicu-dev \
        libjpeg62-turbo-dev \
        libpng-dev \
        libwebp-dev \
        libxml2-dev \
        libzip-dev \
        unzip \
    && rm -rf \
        /tmp/composer \
        /usr/local/bin/composer \
        /usr/local/bin/node \
        /usr/local/bin/npm \
        /usr/local/bin/npx \
        /usr/local/lib/node_modules \
        /var/lib/apt/lists/* \
        node_modules \
    && cp config/system/settings.php.example config/system/settings.php \
    && cp config/system/additional.coolify.php config/system/additional.php \
    && mkdir -p public/fileadmin public/typo3temp/assets var /run/typo3-secrets \
    && printf 'ok\n' > public/healthz \
    && chown -R www-data:www-data public/fileadmin public/typo3temp var /run/typo3-secrets \
    && chmod 0755 public public/_assets \
    && chmod 0755 public/fileadmin public/typo3temp public/typo3temp/assets var

COPY docker/coolify/apache-vhost.conf /etc/apache2/sites-available/000-default.conf
COPY docker/coolify/php.ini /usr/local/etc/php/conf.d/zz-typo3-production.ini
COPY --chmod=0755 docker/coolify/entrypoint.sh /usr/local/bin/typo3-entrypoint

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
    CMD curl -fsS --user "${BASIC_AUTH_USER}:${BASIC_AUTH_PASSWORD}" http://127.0.0.1/healthz >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/typo3-entrypoint"]
CMD ["apache2-foreground"]
