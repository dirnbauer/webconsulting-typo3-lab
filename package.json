{
  "name": "webconsulting-typo3-lab",
  "private": true,
  "packageManager": "npm@12.2.1",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-var/playwright/browsers} playwright install chromium",
    "test:e2e": "npm run test:e2e:install && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-var/playwright/browsers} playwright test",
    "test:e2e:headed": "npm run test:e2e:install && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-var/playwright/browsers} playwright test --headed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.5",
    "vite-plugin-typo3": "^3.0.0"
  },
  "dependencies": {
    "agentation-mcp": "^1.3.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
