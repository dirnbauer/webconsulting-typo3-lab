#!/usr/bin/env bash
#ddev-generated
## Description: Create and destroy solr cores and configsets
## Usage: solrctl [apply|wipe|list] [config path] [--no-start]
## Example: "ddev solrctl apply --no-start"

CMD=$1
YAML_FILE=".ddev/typo3-solr/config.yaml"
SOLR_HEALTH_URL="http://typo3-solr:8983/solr/admin/info/system?wt=json"
START_PROJECT=1

for arg in "${@:2}"; do
    if [ "$arg" = "--no-start" ]; then
        START_PROJECT=0
    fi
done

wait_for_solr() {
    for _ in {1..30}; do
        if ddev exec curl --noproxy typo3-solr -fsS "$SOLR_HEALTH_URL" >/dev/null 2>&1; then
            return 0
        fi

        sleep 1
    done

    echo "Solr did not become ready at $SOLR_HEALTH_URL"
    exit 1
}

# Start the project if not already running, so we can interact with solr
if [ "$START_PROJECT" -eq 1 ]; then
    ddev_status=$(ddev describe -j 2>/dev/null | sed -n 's/.*"status":"\([^"]*\)","status_desc".*/\1/p')
    if [ "$ddev_status" != "running" ]; then
        ddev start
    fi
fi

case $CMD in
apply)
    for arg in "${@:2}"; do
        if [ "$arg" != "--no-start" ]; then
            YAML_FILE="$arg"
        fi
    done

    if [ ! -f "$YAML_FILE" ]; then
        echo "Add-on config file $YAML_FILE does not exist."
        exit 1
    fi

    echo "Apply config $YAML_FILE"

    # Make Solr volume writable for web container, then copy files
    ddev exec -s typo3-solr -u root chmod -R 777 /var/solr/
    ddev solrctl-worker copy-config "$YAML_FILE"

    # Restore file ownership for Solr
    ddev exec -s typo3-solr -u root chown -R solr:solr /var/solr/
    ddev utility rebuild -s typo3-solr --cache 1>/dev/null
    wait_for_solr

    # Create cores via Solr API
    ddev solrctl-worker create-cores "$YAML_FILE"
    ;;

wipe)
    # Make Solr volume writable, then unload cores and delete files via web container
    ddev exec -s typo3-solr -u root chmod -R 777 /var/solr/
    ddev solrctl-worker wipe

    ddev utility rebuild -s typo3-solr --cache 1>/dev/null
    ;;

list)
    ddev solrctl-worker list
    ;;

--help | *)
    echo "——————————————"
    echo -e "\033[1mExample Usage:\033[0m"
    echo "——————————————"
    echo -e "\033[1mApply\033[0m"
    echo "—————"
    echo "Create solr cores and configsets defined in .ddev/typo3-solr/config.yaml"
    echo "👉 ddev solrctl apply [config path] - relative to docroot, optional"
    echo "👉 ddev solrctl apply --no-start - skip the automatic project start (for hooks)"
    echo ""
    echo -e "\033[1mWipe\033[0m"
    echo "—————"
    echo "Remove solr cores and configset"
    echo "👉 ddev solrctl wipe"
    echo ""
    echo -e "\033[1mList\033[0m"
    echo "—————"
    echo "List configured Solr cores"
    echo "👉 ddev solrctl list [--no-start]"
    ;;
esac
