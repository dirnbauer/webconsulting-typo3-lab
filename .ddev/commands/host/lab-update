#!/usr/bin/env bash

## Description: Update the named Composer packages, run extension setup, reseed the Desiderio showcase and flush caches.
## Usage: lab-update <package>... [composer update arguments] | lab-update --all
## Example: "ddev lab-update webconsulting/desiderio -W" | "ddev lab-update --all"

set -euo pipefail

cd "${DDEV_APPROOT}"

# Name the packages to update. A bare `composer update -W` moves every
# dependency of the lab at once, which is never what a content or theme
# release needs; --all keeps that possible on purpose.
if [ "$#" -eq 0 ]; then
  echo "Name the packages to update, e.g. 'ddev lab-update webconsulting/desiderio -W', or pass --all." >&2
  exit 2
fi
composer_args=("$@")
if [ "$1" = "--all" ]; then
  composer_args=(-W)
fi

if Build/Scripts/lab-link.sh --status >/dev/null 2>&1; then
  :
else
  echo "Development clones are linked into vendor/ (see Build/Scripts/lab-link.sh --status)." >&2
  echo "Restore them first: composer would replace the links with the released packages." >&2
  exit 1
fi

echo "==> Updating Composer packages"
echo "    composer update ${composer_args[*]} --no-interaction"
# The lab installs many packages from source. Local fixes belong in their
# package repositories, not in vendor/, so dirty vendor checkouts are discarded.
ddev exec env COMPOSER_DISCARD_CHANGES=true composer update "${composer_args[@]}" --no-interaction

echo "==> Running TYPO3 extension setup"
ddev exec vendor/bin/typo3 extension:setup --no-interaction

echo "==> Refreshing Desiderio styleguide seed content"
ddev exec vendor/bin/typo3 desiderio:styleguide:seed --no-interaction
# The styleguide seed replaces content in every language, which takes the
# German/Chinese/Hungarian 404, search and accessibility texts with it.
ddev exec vendor/bin/typo3 sitepackage:seed-utility-translations --no-interaction
# It also replaces the content of the Powermail Lab page, including the section
# that lists the Jev example forms 07-11. Their seeder builds that section
# again, together with the forms, decisions and conditions it lists.
echo "==> Refreshing the Jev Powermail examples"
ddev exec vendor/bin/typo3 webcon-jev:examples:seed --no-interaction
# The seeders above create the site in English. Its German, Chinese and
# Hungarian pages come from the translation memories in site_package, keyed by
# the English text, so they survive the new uids of a reseed.
echo "==> Translating the Desiderio site (de, zh, hu)"
ddev exec vendor/bin/typo3 sitepackage:content:translate --site=desiderio --no-interaction

# Legacy URLs from when Desiderio lived below /desiderio/ keep working: each
# points at the page that holds that content now, resolved by slug at run time
# because a reseed gives pages new uids.
page_uid_by_slug() {
  # </dev/null: it is called inside a `while read` loop, whose input ddev
  # would otherwise swallow after the first line.
  ddev mysql -N -e "SELECT uid FROM pages WHERE slug='$1' AND sys_language_uid=0 AND deleted=0 AND hidden=0 ORDER BY uid LIMIT 1" </dev/null | tr -d '[:space:]'
}

echo "==> Pointing legacy Desiderio URLs at the current pages"
redirects=()
# Pairs of "legacy path|current slug". A plain list rather than an associative
# array: macOS ships bash 3.2, where `declare -A` does not exist.
slug_map='
/desiderio/content-types/content-editorial|/content-types/content-editorial
/desiderio/content-types/leads-conversion|/content-types/leads-conversion
/desiderio/content-types/data-dashboards|/content-types/data-dashboards
/desiderio/content-types/features-benefits|/content-types/features-benefits
/desiderio/content-types/footers-utility-areas|/content-types/footers-utility-areas
/desiderio/content-types/hero-landing-intros|/content-types/hero-landing-intros
/desiderio/content-types/navigation-wayfinding|/content-types/navigation-wayfinding
/desiderio/content-types/plans-pricing|/content-types/plans-pricing
/desiderio/content-types/trust-social-proof|/content-types/trust-social-proof
/desiderio/content-types/people-team|/content-types/people-team
/desiderio/target-groups/for-agencies-integrators/|/target-groups/for-agencies
/desiderio/target-groups/for-in-house-marketing-product-teams/|/target-groups/for-inhouse-teams
/desiderio/target-groups/for-freelancers-solo-developers/|/target-groups/for-freelancers
'
while IFS='|' read -r source_path slug; do
  [ -n "${source_path}" ] || continue
  uid="$(page_uid_by_slug "${slug}")"
  if [ -n "${uid}" ]; then
    redirects+=("${source_path}|t3://page?uid=${uid}&_language=0")
  else
    echo "    no page at ${slug}; ${source_path} left as it is" >&2
  fi
done <<< "${slug_map}"

for redirect in "${redirects[@]}"; do
  source_path="${redirect%%|*}"
  target="${redirect#*|}"
  ddev mysql -e "
    UPDATE sys_redirect
       SET target='${target}', disabled=0, deleted=0, updatedon=UNIX_TIMESTAMP(), target_statuscode=307
     WHERE source_host='webconsulting-typo3-lab.ddev.site'
       AND source_path='${source_path}';
    INSERT INTO sys_redirect
      (pid, updatedon, createdon, deleted, disabled, source_host, source_path, target, target_statuscode, redirect_type, creation_type, integrity_status)
    SELECT
      0, UNIX_TIMESTAMP(), UNIX_TIMESTAMP(), 0, 0, 'webconsulting-typo3-lab.ddev.site', '${source_path}', '${target}', 307, 'default', 1, 'no_conflict'
    WHERE NOT EXISTS (
      SELECT 1 FROM sys_redirect
       WHERE source_host='webconsulting-typo3-lab.ddev.site'
         AND source_path='${source_path}'
         AND deleted=0
    );
  "
done

echo "==> Flushing TYPO3 caches"
ddev exec vendor/bin/typo3 cache:flush --no-interaction

echo "==> Installed Webconsulting extension versions"
ddev exec composer show --direct --no-interaction \
  | awk '/^(webconsulting|dirnbauer|sgalinski|studiomitte|hn|in2code|georgringer|t3g|apache-solr-for-typo3)\// { print }'

echo "Done. If a browser tab still shows old CSS, hard-refresh it; TYPO3 and published extension assets are updated."
echo "Not reseeded here: the corporate starter, the element library folders, Astryx and Agent Nexus (see docs/content/seeding.md)."
