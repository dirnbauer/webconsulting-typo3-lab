#!/usr/bin/env bash

## Description: Update the TYPO3 Lab to the latest Composer package versions, publish assets, run extension setup, and flush caches.
## Usage: lab-update [composer update arguments]
## Example: "ddev lab-update" | "ddev lab-update webconsulting/desiderio -W"

set -euo pipefail

cd "${DDEV_APPROOT}"

composer_args=("$@")
if [ "${#composer_args[@]}" -eq 0 ]; then
  composer_args=(-W)
fi

echo "==> Updating Composer packages"
echo "    composer update ${composer_args[*]} --no-interaction"
# The lab installs many packages from source. Local fixes belong in their
# package repositories, not in vendor/, so dirty vendor checkouts are discarded.
ddev exec env COMPOSER_DISCARD_CHANGES=true composer update "${composer_args[@]}" --no-interaction

echo "==> Running TYPO3 extension setup"
ddev exec vendor/bin/typo3 extension:setup --no-interaction

echo "==> Refreshing Desiderio styleguide seed content"
ddev exec vendor/bin/typo3 desiderio:styleguide:seed --no-interaction

echo "==> Retiring legacy Desiderio content-type URLs"
# The seeded hub page (slug /content-types, holds the element catalog) stays
# visible; only the retired legacy chapter pages BELOW it stay hidden.
ddev mysql -e "UPDATE pages SET hidden=1 WHERE pid=1093 OR (pid=505 AND slug='/content-types' AND sys_language_uid > 0);"
ddev mysql -e "UPDATE pages SET hidden=0 WHERE uid=1093 AND deleted=0;"
# Legacy target-group detail pages are superseded by the seeded /for-* pages.
ddev mysql -e "UPDATE pages SET hidden=1 WHERE uid IN (983,984,985,1094) AND deleted=0;"

# Resolve redirect targets by slug so reseeded page uids never go stale.
page_uid_by_slug() {
  ddev mysql -N -e "SELECT uid FROM pages WHERE slug='$1' AND sys_language_uid=0 AND deleted=0 AND hidden=0 ORDER BY uid LIMIT 1" | tr -d '[:space:]'
}

redirects=()
declare -A slug_map=(
  ["/desiderio/content-types/content-editorial"]="/desiderio-content"
  ["/desiderio/content-types/leads-conversion"]="/desiderio-conversion"
  ["/desiderio/content-types/data-dashboards"]="/desiderio-data"
  ["/desiderio/content-types/features-benefits"]="/desiderio-features"
  ["/desiderio/content-types/footers-utility-areas"]="/desiderio-footer"
  ["/desiderio/content-types/hero-landing-intros"]="/desiderio-hero"
  ["/desiderio/content-types/navigation-wayfinding"]="/desiderio-navigation"
  ["/desiderio/content-types/plans-pricing"]="/desiderio-pricing"
  ["/desiderio/content-types/trust-social-proof"]="/desiderio-social-proof"
  ["/desiderio/content-types/people-team"]="/desiderio-team"
  ["/desiderio/target-groups/for-agencies-integrators/"]="/for-agencies"
  ["/desiderio/target-groups/for-in-house-marketing-product-teams/"]="/for-inhouse-teams"
  ["/desiderio/target-groups/for-freelancers-solo-developers/"]="/for-freelancers"
)
for source_path in "${!slug_map[@]}"; do
  uid="$(page_uid_by_slug "${slug_map[$source_path]}")"
  if [ -n "${uid}" ]; then
    redirects+=("${source_path}|t3://page?uid=${uid}&_language=0")
  fi
done
# The bare /content-types URL is answered by the visible hub page itself.
ddev mysql -e "DELETE FROM sys_redirect WHERE source_host='webconsulting-typo3-lab.ddev.site' AND source_path='/desiderio/content-types';"

for redirect in "${redirects[@]}"; do
  source_path="${redirect%%|*}"
  target="${redirect#*|}"
  ddev mysql -e "
    UPDATE sys_redirect
       SET target='${target}', disabled=0, deleted=0, updatedon=UNIX_TIMESTAMP(), target_statuscode=307
     WHERE source_host='webconsulting-typo3-lab.ddev.site'
       AND source_path='${source_path}';
    INSERT INTO sys_redirect
      (pid, updatedon, createdon, deleted, disabled, source_host, source_path, target, target_statuscode, redirect_type, creation_type, integrity_status)
    SELECT
      0, UNIX_TIMESTAMP(), UNIX_TIMESTAMP(), 0, 0, 'webconsulting-typo3-lab.ddev.site', '${source_path}', '${target}', 307, 'default', 1, 'no_conflict'
    WHERE NOT EXISTS (
      SELECT 1 FROM sys_redirect
       WHERE source_host='webconsulting-typo3-lab.ddev.site'
         AND source_path='${source_path}'
         AND deleted=0
    );
  "
done

echo "==> Flushing TYPO3 caches"
ddev exec vendor/bin/typo3 cache:flush --no-interaction

echo "==> Installed Webconsulting extension versions"
ddev exec composer show --direct --no-interaction \
  | awk '/^(webconsulting|dirnbauer|sgalinski|studiomitte|hn|in2code|georgringer|t3g|apache-solr-for-typo3)\// { print }'

echo "Done. If a browser tab still shows old CSS, hard-refresh it; TYPO3 and published extension assets are updated."
