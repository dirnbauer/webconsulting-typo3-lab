# The DDEV 1.25.3 base image predates PHP's October 2026 security fixes.
# Fail the image build rather than silently retaining an unpatched runtime.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --only-upgrade \
        --no-install-recommends -o Dpkg::Options::="--force-confold" 'php8.5*'; \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' php8.5-cli)" ge 8.5.12; \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' php8.5-fpm)" ge 8.5.12; \
    php8.5 --version; \
    php-fpm8.5 --version; \
    rm -rf /var/lib/apt/lists/*
