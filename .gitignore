.DS_Store
._*
.ddev/config.local.yaml
.idea
nbproject
/var/*
!/var/labels
/vendor
/public/*
# normally we would ignore the whole fileadmin folder. but for the demo we need to keep fileadmin
!/public/fileadmin
/public/fileadmin/*
!/public/fileadmin/user_upload
/public/fileadmin/user_upload/_temp_
!/public/.htaccess
node_modules/*
apps/*/.next/
.cursor
.firecrawl/
scripts/*
/var/labels/*
/packages/bad_shop_watch/
# Nested development clones of own extensions (github.com/dirnbauer/*). Composer installs
# them from GitHub; link a clone into vendor/ with Build/Scripts/lab-link.sh while developing.
/packages/*/
!/packages/site_package/
/.ddev/traefik/
/backup-*/
/.tarballs/*
!/.tarballs/README.md
# Rotated passwords, wherever a script or a stray working directory puts them.
be-password-*.txt
/Build/.tarballs/
/.abilities-demo-token
/backup-abilities-reseed/

# Ad-hoc local DB dumps (20 MB+, stale the moment they are written) stay out
# of version control. Real backups live in .ddev/db_snapshots and ~/backups.
dump.sql.gz
*.sql.gz
# Safety copies taken before a destructive migration (table dumps, pre-update
# composer.lock). Same reasoning: local, large and stale on arrival.
/Build/backup/
