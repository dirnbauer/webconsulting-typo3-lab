.DS_Store
._*
.ddev/config.local.yaml
.idea
nbproject
/var/*
!/var/labels
/vendor
/public/*
# normally we would ignore the whole fileadmin folder. but for the demo we need to keep fileadmin
!/public/fileadmin
/public/fileadmin/*
!/public/fileadmin/user_upload
/public/fileadmin/user_upload/_temp_
# Imported by sitepackage:seed-poppy from the versioned source diagrams.
/public/fileadmin/user_upload/poppy/
!/public/.htaccess
node_modules/*
apps/*/.next/
.cursor
.claude/
.firecrawl/
scripts/*
/var/labels/*
/packages/bad_shop_watch/
# Nested development clones of own extensions (github.com/dirnbauer/*). Composer installs
# them from GitHub; link a clone into vendor/ with Build/Scripts/lab-link.sh while developing.
/packages/*/
!/packages/site_package/
/.ddev/traefik/
/backup-*/
/.tarballs/*
!/.tarballs/README.md
# Rotated passwords, wherever a script or a stray working directory puts them.
be-password-*.txt
/Build/.tarballs/
/.abilities-demo-token
/backup-abilities-reseed/

# Ad-hoc local DB dumps (20 MB+, stale the moment they are written) stay out
# of version control. Real backups live in .ddev/db_snapshots and ~/backups.
dump.sql.gz
*.sql.gz
# Safety copies taken before a destructive migration (table dumps, pre-update
# composer.lock). Same reasoning: local, large and stale on arrival.
/Build/backup/

# Development links recorded by Build/Scripts/lab-link.sh (per checkout)
/.lab-links

# Generated FAL copies of the Redaktion source screenshots
/public/fileadmin/user_upload/redaktion/
# Imported by sitepackage:seed-netresearch-talk from Resources/Public/Images/NetresearchTalk
/public/fileadmin/user_upload/netresearch-talk/

# Optional private Redaktion connector: local Composer profile only
/.composer-redaktion-dev.json
/.composer-redaktion-dev.lock

# Composer credentials (in2code's Early Access Packagist, GitHub tokens) live in
# the global Composer auth or in CI/Coolify secrets only. A project auth.json,
# at any depth, must never be committed; DDEV's project homeadditions would
# copy one into the web container from inside the repository.
auth.json
/.ddev/homeadditions/.composer/
