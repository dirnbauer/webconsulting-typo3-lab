.git
.env
.env.*
# Composer credentials never go into the build context: COPY . . would put them
# into a layer. The in2code token reaches the image build as a BuildKit secret.
auth.json
**/auth.json
# The CI-only script that drops Powermail from GitHub's throw-away checkout
# must never run in the image build: the image carries Powermail and its patches.
Build/Scripts/ci-drop-private-packages.php
.composer
.abilities-demo-token
.claude
.DS_Store
**/.git
**/.DS_Store
.github
.gitlab-ci.yml
.ddev
.idea
.cursor
.firecrawl
.tarballs
apps
backup-*
node_modules
**/node_modules
vendor
**/vendor
var
public/_assets
public/fileadmin
config/system/additional.php
config/system/settings.php
*.sql
*.sql.gz
npm-debug.log*

# Local checkouts of separately versioned extensions. Production installs the
# locked Git revisions through Composer instead of copying these worktrees; only
# the site package is a path repository that the image needs.
packages/*
!packages/site_package

# Local development-link state (Build/Scripts/lab-link.sh)
.lab-links
