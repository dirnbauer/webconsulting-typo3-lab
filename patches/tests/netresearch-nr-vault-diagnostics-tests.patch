+    #[Test]
+    public function boundedVerificationAcceptsAnUnchangedTailWithAPredecessor(): void
+    {
+        $uids = $this->writeBoundedRangeFixture();
+        $result = $this->get(AuditLogServiceInterface::class)->verifyHashChain($uids[1], $uids[2]);
+
+        self::assertTrue($result->isValid());
