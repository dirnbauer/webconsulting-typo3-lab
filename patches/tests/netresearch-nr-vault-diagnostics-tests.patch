+    #[Test]
+    public function mixedEpochOneAndThreeHistoryMigratesWithoutChangingSecretRows(): void
+    {
+        $this->configureAuditHmacEpoch(1);
+        $identifier = $this->generateUuidV7();
+        $this->get(VaultServiceInterface::class)->store($identifier, 'synthetic-migration-value');
+
+        $this->configureAuditHmacEpoch(3);
+        $configuration = new ExtensionConfiguration(new Typo3ExtensionConfiguration());
+        $audit = new AuditLogService(
+            $this->get(ConnectionPool::class),
+            $this->get(AccessControlServiceInterface::class),
+            $this->get(MasterKeyProviderInterface::class),
+            $configuration,
+            $this->get(AuditChainAnchorStoreInterface::class),
+        );
+        $audit->log($identifier, 'read', true);
+        $before = $audit->verifyHashChain();
+        self::assertTrue($before->isValid());
+        self::assertTrue($before->hasMixedEpochs());
+
+        $secrets = $this->getConnectionPool()->getConnectionForTable('tx_nrvault_secret');
+        $secretRowsBefore = $secrets->select(['*'], 'tx_nrvault_secret', [])->fetchAllAssociative();
+        $wizard = new AuditHmacMigration(
+            $this->get(ConnectionPool::class),
+            $this->get(MasterKeyProviderInterface::class),
+            $configuration,
+            $audit,
+            $this->get(AuditChainAnchorStoreInterface::class),
+        );
+
+        self::assertTrue($wizard->executeUpdate());
+        $after = $audit->verifyHashChain();
+        self::assertTrue($after->isValid());
+        self::assertSame([3 => array_sum($before->epochCounts)], $after->epochCounts);
+        self::assertTrue(
+            $secretRowsBefore === $secrets->select(['*'], 'tx_nrvault_secret', [])->fetchAllAssociative(),
+            'Audit migration must leave all secret rows unchanged.',
+        );
+        self::assertFalse($wizard->updateNecessary());
+    }
