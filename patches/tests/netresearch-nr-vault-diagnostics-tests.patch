+        self::assertSame([1 => 2], $result->epochCounts);
+    }
+
+    #[Test]
+    public function boundedVerificationStillRejectsTamperingOfItsFirstRow(): void
+    {
+        $uids = $this->writeBoundedRangeFixture();
+        $this->getConnectionPool()->getConnectionForTable('tx_nrvault_audit_log')->update(
+            'tx_nrvault_audit_log',
+            ['action' => 'delete'],
+            ['uid' => $uids[1]],
+        );
+
+        $result = $this->get(AuditLogServiceInterface::class)->verifyHashChain($uids[1], $uids[2]);
+
+        self::assertFalse($result->isValid());
+        self::assertArrayHasKey($uids[1], $result->errors);
+    }
+
+    #[Test]
+    public function boundedVerificationRejectsADeletedPredecessor(): void
+    {
+        $uids = $this->writeBoundedRangeFixture();
+        $this->getConnectionPool()->getConnectionForTable('tx_nrvault_audit_log')->delete(
+            'tx_nrvault_audit_log',
+            ['uid' => $uids[0]],
+        );
+
+        $result = $this->get(AuditLogServiceInterface::class)->verifyHashChain($uids[1], $uids[2]);
+
+        self::assertFalse($result->isValid());
+    }
+
+    #[Test]
+    public function boundedVerificationRejectsAnEpochDowngradeAtItsFirstRow(): void
+    {
+        $uids = $this->writeBoundedRangeFixture();
+        $connection = $this->getConnectionPool()->getConnectionForTable('tx_nrvault_audit_log');
+        $row = $connection->select(['*'], 'tx_nrvault_audit_log', ['uid' => $uids[1]])->fetchAssociative();
+        self::assertIsArray($row);
+        self::assertIsString($row['previous_hash']);
+        $entry = AuditLogService::extractHashRow($row);
+        $keylessHash = AuditLogService::calculateHash(
+            $entry['uid'],
+            $entry['secretId'],
+            $entry['action'],
+            $entry['actorUid'],
+            $entry['crdate'],
+            $row['previous_hash'],
+        );
+        $connection->update('tx_nrvault_audit_log', [
+            'hmac_key_epoch' => 0,
+            'entry_hash' => $keylessHash,
+        ], ['uid' => $uids[1]]);
+
+        $result = $this->get(AuditLogServiceInterface::class)->verifyHashChain($uids[1], $uids[1]);
+
+        self::assertFalse($result->isValid());
+        self::assertStringContainsString('downgrade', strtolower($result->errors[$uids[1]] ?? ''));
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function writeBoundedRangeFixture(): array
+    {
+        $audit = $this->get(AuditLogServiceInterface::class);
+        foreach (['bounded-one', 'bounded-two', 'bounded-three'] as $identifier) {
+            $audit->log($identifier, 'read', true);
+        }
+
+        return array_map(
+            static fn (mixed $uid): int => (int) $uid,
+            $this->getConnectionPool()->getConnectionForTable('tx_nrvault_audit_log')
+                ->createQueryBuilder()->select('uid')->from('tx_nrvault_audit_log')
+                ->orderBy('uid', 'ASC')->executeQuery()->fetchFirstColumn(),
+        );
+    }
 }
