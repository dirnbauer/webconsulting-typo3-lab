+    #[Test]
+    public function chatCompletionWithToolsForwardsReasoningEffortOnLegacyEndpoint(): void
+    {
+        $payload = $this->captureToolsPayload(
+            [['role' => 'user', 'content' => 'hi']],
+            [ToolSpec::function('get_time', 'Get time', ['type' => 'object', 'properties' => []])],
+            ['reasoning_effort' => 'none'],
+        );
+
+        self::assertSame('none', $payload['reasoning_effort']);
+        self::assertArrayHasKey('messages', $payload);
+        self::assertArrayNotHasKey('input', $payload);
+    }
+
+    #[Test]
+    public function chatCompletionWithToolsSupportsResponsesApi(): void
+    {
+        $captured = null;
+        $subject = $this->createCapturingSubject($captured, [
+            'id' => 'resp-test',
+            'status' => 'completed',
+            'model' => 'gpt-5.6-terra',
+            'output' => [
+                [
+                    'type' => 'function_call',
+                    'call_id' => 'call_123',
+                    'name' => 'get_weather',
+                    'arguments' => '{"location":"Vienna"}',
+                ],
+            ],
+            'usage' => ['input_tokens' => 12, 'output_tokens' => 4, 'total_tokens' => 16],
+        ]);
+        $messages = [
+            ChatMessage::user('What is the weather?'),
+            ChatMessage::assistantToolCalls([ToolCall::function('call_old', 'get_weather', ['location' => 'Graz'])]),
+            ChatMessage::toolResult('call_old', '{"temperature":20}'),
+        ];
+        $tools = [
+            ToolSpec::function(
+                'get_weather',
+                'Get weather',
+                ['type' => 'object', 'properties' => ['location' => ['type' => 'string']]],
+            ),
+        ];
+
+        $result = $subject->chatCompletionWithTools($messages, $tools, [
+            'api_mode' => 'responses',
+            'model' => 'gpt-5.6-terra',
+            'reasoning_effort' => 'medium',
+            'parallel_tool_calls' => true,
+        ]);
+
+        $payload = $this->decodeCaptured($captured);
+        self::assertArrayNotHasKey('messages', $payload);
+        self::assertSame('gpt-5.6-terra', $payload['model']);
+        self::assertSame(['effort' => 'medium'], $payload['reasoning']);
+        self::assertTrue($payload['parallel_tool_calls']);
+        self::assertSame('get_weather', $payload['tools'][0]['name']);
+        self::assertSame('function_call', $payload['input'][1]['type']);
+        self::assertSame('function_call_output', $payload['input'][2]['type']);
+        self::assertSame('call_old', $payload['input'][2]['call_id']);
+
+        self::assertSame('tool_calls', $result->finishReason);
+        self::assertNotNull($result->toolCalls);
+        self::assertSame('get_weather', $result->toolCalls[0]->name);
+        self::assertSame(['location' => 'Vienna'], $result->toolCalls[0]->arguments);
+        self::assertSame(16, $result->usage->totalTokens);
+    }
