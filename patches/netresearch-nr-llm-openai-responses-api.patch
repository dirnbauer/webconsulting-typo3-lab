+    /**
+     * Execute an nr_llm tool loop through OpenAI's Responses API.
+     *
+     * @param list<array<string, mixed>> $messages
+     * @param list<ToolSpec>             $tools
+     * @param array<string, mixed>       $options
+     */
+    private function responsesCompletionWithTools(
+        array $messages,
+        array $tools,
+        array $options,
+        string $model,
+    ): CompletionResponse {
+        $payload = [
+            'model' => $model,
+            'input' => $this->buildResponsesInput($messages),
+            'tools' => array_map(
+                static fn(ToolSpec $spec): array => [
+                    'type' => 'function',
+                    'name' => $spec->name,
+                    'description' => $spec->description,
+                    'parameters' => $spec->parameters,
+                ],
+                $tools,
+            ),
+            'max_output_tokens' => $this->getInt($options, 'max_tokens', 4096),
+            'store' => false,
+            ...$this->buildSamplingParams($model, $options),
+        ];
+
+        $reasoningEffort = $this->getString($options, 'reasoning_effort');
+        if ($reasoningEffort !== '') {
+            $payload['reasoning'] = ['effort' => $reasoningEffort];
+        }
+
+        if (isset($options['tool_choice'])) {
+            $payload['tool_choice'] = $options['tool_choice'];
+        }
+        if (isset($options['parallel_tool_calls'])) {
+            $payload['parallel_tool_calls'] = $this->getBool($options, 'parallel_tool_calls');
+        }
+
+        $response = $this->sendRequest(self::ENDPOINT_RESPONSES, $payload);
+        $usage = $this->getArray($response, 'usage');
+        $contentParts = [];
+        $toolCalls = [];
+
+        foreach ($this->getList($response, 'output') as $rawItem) {
+            $item = $this->asArray($rawItem);
+            $type = $this->getString($item, 'type');
+
+            if ($type === 'message') {
+                foreach ($this->getList($item, 'content') as $rawPart) {
+                    $part = $this->asArray($rawPart);
+                    if ($this->getString($part, 'type') === 'output_text') {
+                        $text = $this->getString($part, 'text');
+                        if ($text !== '') {
+                            $contentParts[] = $text;
+                        }
+                    }
+                }
+                continue;
+            }
+
+            if ($type !== 'function_call') {
+                continue;
+            }
+
+            $id = $this->getString($item, 'call_id', $this->getString($item, 'id'));
+            $name = $this->getString($item, 'name');
+            if ($id === '' || $name === '') {
+                continue;
+            }
+
+            $arguments = json_decode($this->getString($item, 'arguments', '{}'), true);
+            $toolCalls[] = ToolCall::function(
+                $id,
+                $name,
+                is_array($arguments) ? $arguments : [],
+            );
+        }
+
+        $status = $this->getString($response, 'status', 'completed');
+        $incompleteDetails = $this->getArray($response, 'incomplete_details');
+        $finishReason = $this->getString($incompleteDetails, 'reason') === 'max_output_tokens'
+            ? 'length'
+            : ($toolCalls !== [] ? 'tool_calls' : ($status === 'completed' ? 'stop' : $status));
+
+        return new CompletionResponse(
+            content: implode("\n", $contentParts),
+            model: $this->getString($response, 'model', $model),
+            usage: $this->createUsageStatistics(
+                promptTokens: $this->getInt($usage, 'input_tokens'),
+                completionTokens: $this->getInt($usage, 'output_tokens'),
+            ),
+            finishReason: $finishReason,
+            provider: $this->getIdentifier(),
+            toolCalls: $toolCalls !== [] ? $toolCalls : null,
+            metadata: $this->rawResponseMetadata($options, $response),
+        );
+    }
+
+    /**
+     * Convert the chat-shaped history used by nr_llm into Responses input
+     * items. Tool calls and their results must be separate correlated items.
+     *
+     * @param list<array<string, mixed>> $messages
+     *
+     * @return list<array<string, mixed>>
+     */
+    private function buildResponsesInput(array $messages): array
+    {
+        $input = [];
+
+        foreach ($messages as $message) {
+            $role = $this->getString($message, 'role');
+            $content = $this->getString($message, 'content');
+
+            if ($role === 'tool') {
+                $callId = $this->getString($message, 'tool_call_id');
+                if ($callId !== '') {
+                    $input[] = [
+                        'type' => 'function_call_output',
+                        'call_id' => $callId,
+                        'output' => $content,
+                    ];
+                }
+                continue;
+            }
+
+            if ($role === 'assistant' && isset($message['tool_calls']) && is_array($message['tool_calls'])) {
+                if ($content !== '') {
+                    $input[] = ['role' => 'assistant', 'content' => $content];
+                }
+
+                foreach ($message['tool_calls'] as $rawToolCall) {
+                    $toolCall = $this->asArray($rawToolCall);
+                    $function = $this->getArray($toolCall, 'function');
+                    $id = $this->getString($toolCall, 'id');
+                    $name = $this->getString($function, 'name');
+                    if ($id === '' || $name === '') {
+                        continue;
+                    }
+
+                    $arguments = $function['arguments'] ?? '{}';
+                    if (is_array($arguments)) {
+                        $arguments = json_encode($arguments !== [] ? $arguments : new \stdClass(), JSON_THROW_ON_ERROR);
+                    }
+
+                    $input[] = [
+                        'type' => 'function_call',
+                        'call_id' => $id,
+                        'name' => $name,
+                        'arguments' => is_string($arguments) ? $arguments : '{}',
+                    ];
+                }
+                continue;
+            }
+
+            if ($role !== '') {
+                $input[] = ['role' => $role, 'content' => $content];
+            }
+        }
+
+        return $input;
+    }
+
     public function supportsTools(): bool
     {
         return true;
