+    // zones are reachable. The enlarged-preview flyout is not a drag source, so
+    // if it happens to be open when a drag starts, just close it.
+    this.collapsed = !!dragInProgressStore.value;
+    if (this.collapsed) {
+      this.#closePreview();
+    }
+  }
+
+  #toggleGroup(group) {
+    const next = new Set(this.selectedGroups);
+    next.has(group) ? next.delete(group) : next.add(group);
+    this.selectedGroups = next;
+    elementLibraryCategories.set([...next]);
+  }
+
+  #clearFilters() {
+    this.selectedGroups = new Set();
+    this.searchTerm = '';
+    elementLibraryCategories.set([]);
+    elementLibrarySearch.set('');
+  }
+
+  /**
+   * The ve-drag payload read by <ve-drop-zone>. `uid: -1` never collides with a
+   * drop zone's own uid; libraryMode picks copy-the-demo-record vs create-empty.
+   * @param {Object} item
+   */
+  #dragData(item) {
+    return {
+      table: 'tt_content',
+      uid: -1,
+      CType: item.cType,
+      libraryMode: this.includeDemo && item.demoUid > 0 ? 'copy' : 'new',
+      demoUid: item.demoUid,
