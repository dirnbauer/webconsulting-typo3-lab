+    event.currentTarget.classList.add('is-dragging');
+    dragInProgressStore.value = info;
+    initVelocityScroll(event);
+  }
+
+  #cardDragEnd(event) {
+    event.currentTarget.classList.remove('is-dragging');
+    dragInProgressStore.value = false;
+  }
+
+  // --- lazy preview loading -------------------------------------------------
+
+  updated() {
+    const grid = this.shadowRoot.querySelector('.grid');
+    if (!grid) {
+      // panel closed: drop the observer, it is bound to the now-removed grid
+      this.observer?.disconnect();
+      this.observer = null;
+      this.gridElement = null;
+      return;
+    }
+    // (re)create the observer whenever a fresh grid element appears, otherwise
+    // it keeps observing relative to a detached root and never fires
+    if (grid !== this.gridElement) {
+      this.observer?.disconnect();
