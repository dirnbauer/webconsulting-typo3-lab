+                <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/>
+                <path d="M21 21l-4.6-4.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
+                <path d="M10.5 7.6v5.8M7.6 10.5h5.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
