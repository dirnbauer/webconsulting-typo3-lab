@@ -0,0 +1,467 @@
+import {css, html, LitElement} from 'lit';
+import {classMap} from 'lit/directives/class-map.js';
+import {lll} from '@typo3/core/lit-helper.js';
+import {dragInProgressStore} from '@typo3/visual-editor/Frontend/stores/drag-store';
+import {initVelocityScroll} from '@typo3/visual-editor/Frontend/components/ve-drag-handle/velocity-scroll';
+import {filterItems} from '@typo3/visual-editor/Frontend/components/ve-element-library/filter';
+
+const PREVIEW_RENDER_WIDTH = 1280;
+
+/**
+ * Element library side panel: a browsable, filterable catalog of all
+ * content element types with big rendered previews (shadcn-blocks explorer
+ * style). Cards are dragged into the existing <ve-drop-zone> targets; the
+ * "include demo content" switch decides whether the drop copies the seeded
+ * demo record or creates an empty element of that type.
+ *
+ * Data comes from the ?elementLibrary=1 endpoint (provided by a companion
+ * extension, e.g. desiderio); the panel only appears when
+ * window.veInfo.elementLibraryEnabled is true.
+ *
+ * @extends {HTMLElement}
+ */
+export class VeElementLibrary extends LitElement {
+  static properties = {
+    open: {type: Boolean, state: true, attribute: false},
+    collapsed: {type: Boolean, state: true, attribute: false},
+    loading: {type: Boolean, state: true, attribute: false},
+    error: {type: String, state: true, attribute: false},
+    items: {type: Array, state: true, attribute: false},
+    categories: {type: Array, state: true, attribute: false},
+    selectedGroups: {type: Object, state: true, attribute: false},
+    searchTerm: {type: String, state: true, attribute: false},
+    includeDemo: {type: Boolean, state: true, attribute: false},
+  };
+
+  constructor() {
+    super();
+    this.open = false;
+    this.collapsed = false;
+    this.loading = false;
+    this.error = '';
+    this.items = [];
+    this.categories = [];
+    this.selectedGroups = new Set();
+    this.searchTerm = '';
+    this.includeDemo = true;
+    this.onDragInProgressChange = this.#onDragInProgressChange.bind(this);
+  }
+
+  connectedCallback() {
+    super.connectedCallback();
+    dragInProgressStore.addEventListener('change', this.onDragInProgressChange);
+  }
+
+  disconnectedCallback() {
+    dragInProgressStore.removeEventListener('change', this.onDragInProgressChange);
+    super.disconnectedCallback();
+  }
+
+  toggle() {
+    this.open ? this.closePanel() : this.openPanel();
+  }
+
+  openPanel() {
+    this.open = true;
+    if (this.items.length === 0 && !this.loading) {
+      this.#load();
+    }
+  }
+
+  closePanel() {
+    this.open = false;
+  }
+
+  async #load() {
+    this.loading = true;
+    this.error = '';
+    try {
+      const response = await fetch(window.location.pathname + '?elementLibrary=1', {
+        headers: {'X-Request-Token': window.veInfo.token},
+      });
+      if (!response.ok) {
+        const body = await response.json().catch(() => ({}));
+        throw new Error(body.error || ('HTTP ' + response.status));
+      }
+      const data = await response.json();
+      this.items = data.elements || [];
+      this.categories = data.categories || [];
+    } catch (error) {
+      this.error = String(error.message || error);
+    } finally {
+      this.loading = false;
+    }
+  }
+
+  #onDragInProgressChange() {
+    // Slide out of the way while a drag is running so the drop zones are
+    // reachable. transform (not display) - hiding the drag source mid-drag
+    // would abort the native HTML5 drag operation.
+    this.collapsed = !!dragInProgressStore.value;
+  }
+
+  #toggleGroup(group) {
+    const next = new Set(this.selectedGroups);
+    next.has(group) ? next.delete(group) : next.add(group);
+    this.selectedGroups = next;
+  }
+
+  /**
+   * @param {DragEvent} event
+   * @param {Object} item
+   */
+  #cardDragStart(event, item) {
+    event.dataTransfer.effectAllowed = 'copyMove';
+    event.dataTransfer.clearData();
+
+    const info = {
+      table: 'tt_content',
+      // -1: never collides with a drop zone's own uid (0 = top zones)
+      uid: -1,
+      CType: item.cType,
+      libraryMode: this.includeDemo && item.demoUid > 0 ? 'copy' : 'new',
+      demoUid: item.demoUid,
+    };
+    event.dataTransfer.setData('text/ve-drag', JSON.stringify(info));
+    dragInProgressStore.value = info;
+    initVelocityScroll(event);
+  }
+
+  #cardDragEnd() {
+    dragInProgressStore.value = false;
+  }
+
+  render() {
+    if (!this.open) {
+      return html``;
+    }
+
+    const filtered = filterItems(this.items, this.selectedGroups, this.searchTerm);
+    const panelClasses = {
+      panel: true,
+      collapsed: this.collapsed,
+    };
+
+    return html`
+      <div class=${classMap(panelClasses)}>
+        <div class="header">
+          <div class="headerRow">
+            <h2>${lll('frontend.library.title') || 'Add content'}</h2>
+            <button class="closeButton" type="button" @click="${this.closePanel}"
+                    title="${lll('frontend.library.close') || 'Close'}">&times;</button>
+          </div>
+          <input
+            class="search"
+            type="search"
+            .value="${this.searchTerm}"
+            placeholder="${lll('frontend.library.search') || 'Search elements …'}"
+            @input="${(event) => { this.searchTerm = event.target.value; }}"
+          />
+          <div class="chips">
+            ${this.categories.map((category) => html`
+              <button
+                type="button"
+                class="chip ${this.selectedGroups.has(category) ? 'active' : ''}"
+                @click="${() => this.#toggleGroup(category)}"
+              >${category}</button>
+            `)}
+          </div>
+          <label class="includeDemo">
+            <input
+              type="checkbox"
+              .checked="${this.includeDemo}"
+              @change="${(event) => { this.includeDemo = event.target.checked; }}"
+            />
+            ${lll('frontend.library.includeDemo') || 'Include demo content'}
+          </label>
+        </div>
+
+        <div class="grid">
+          ${this.loading ? html`<p class="status">${lll('frontend.library.loading') || 'Loading …'}</p>` : ''}
+          ${this.error ? html`<p class="status error">${this.error}</p>` : ''}
+          ${!this.loading && !this.error && filtered.length === 0 ? html`
+            <p class="status">${lll('frontend.library.empty') || 'No elements match the current filter.'}</p>` : ''}
+          ${filtered.map((item) => this.#renderCard(item))}
+        </div>
+      </div>
+    `;
+  }
+
+  #renderCard(item) {
+    return html`
+      <div
+        class="card"
+        draggable="true"
+        @dragstart="${(event) => this.#cardDragStart(event, item)}"
+        @dragend="${this.#cardDragEnd}"
+        title="${item.description}"
+      >
+        <div class="preview">
+          ${item.previewUrl
+            ? html`<iframe src="${item.previewUrl}" loading="lazy" scrolling="no" tabindex="-1"></iframe>
+                   <div class="previewOverlay"></div>`
+            : html`<div class="previewFallback">${item.iconUrl ? html`<img src="${item.iconUrl}" alt=""/>` : item.cType}</div>`}
+        </div>
+        <div class="meta">
+          <div class="titleRow">
+            <strong>${item.title}</strong>
+            <span class="badge">${item.group}</span>
+          </div>
+          <p>${item.description}</p>
+        </div>
+      </div>
+    `;
+  }
+
+  static styles = css`
+    :host {
+      display: block;
+      font-family: system-ui, -apple-system, sans-serif;
+      font-size: 14px;
+      line-height: 1.4;
+    }
+
+    .panel {
+      position: fixed;
+      inset-block: 0;
+      right: 0;
+      width: min(760px, 92vw);
+      display: flex;
+      flex-direction: column;
+      background: #171717;
+      color: #fafafa;
+      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.45);
+      z-index: 100000;
+      transition: transform 0.25s ease;
+    }
+
+    .panel.collapsed {
+      transform: translateX(100%);
+    }
+
+    .header {
+      padding: 16px 20px 12px;
+      border-bottom: 1px solid #333;
+      display: flex;
+      flex-direction: column;
+      gap: 10px;
+    }
+
+    .headerRow {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+    }
+
+    h2 {
+      margin: 0;
+      font-size: 17px;
+      font-weight: 600;
+    }
+
+    .closeButton {
+      background: none;
+      border: none;
+      color: #aaa;
+      font-size: 26px;
+      line-height: 1;
+      cursor: pointer;
+      padding: 0 4px;
+    }
+
+    .closeButton:hover {
+      color: #fff;
+    }
+
+    .search {
+      width: 100%;
+      box-sizing: border-box;
+      padding: 9px 12px;
+      border-radius: 8px;
+      border: 1px solid #3a3a3a;
+      background: #232323;
+      color: #fafafa;
+      font-size: 14px;
+      outline: none;
+    }
+
+    .search:focus {
+      border-color: #5432fe;
+    }
+
+    .chips {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 6px;
+    }
+
+    .chip {
+      border: 1px solid #3a3a3a;
+      background: #232323;
+      color: #ccc;
+      border-radius: 999px;
+      padding: 4px 12px;
+      font-size: 12.5px;
+      cursor: pointer;
+    }
+
+    .chip:hover {
+      border-color: #666;
+      color: #fff;
+    }
+
+    .chip.active {
+      background: #5432fe;
+      border-color: #5432fe;
+      color: #fff;
+    }
+
+    .includeDemo {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      font-size: 13px;
+      color: #ccc;
+      cursor: pointer;
+      user-select: none;
+    }
+
+    .grid {
+      flex: 1;
+      overflow-y: auto;
+      display: grid;
+      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
+      grid-auto-rows: 330px;
+      gap: 16px;
+      padding: 16px 20px 24px;
+      align-content: start;
+    }
+
+    .status {
+      grid-column: 1 / -1;
+      color: #999;
+      text-align: center;
+      margin: 24px 0;
+    }
+
+    .status.error {
+      color: #ff7b7b;
+    }
+
+    .card {
+      background: #fff;
+      color: #1a1a1a;
+      border-radius: 12px;
+      overflow: hidden;
+      cursor: grab;
+      border: 1px solid #2c2c2c;
+      display: flex;
+      flex-direction: column;
+      height: 330px;
+      transition: outline-color 0.12s ease, transform 0.12s ease;
+      outline: 2px solid transparent;
+    }
+
+    .card:hover {
+      outline-color: #5432fe;
+      transform: translateY(-1px);
+    }
+
+    .card:active {
+      cursor: grabbing;
+    }
+
+    .preview {
+      position: relative;
+      flex: 0 0 240px;
+      height: 240px;
+      overflow: hidden;
+      background: #f4f4f5;
+    }
+
+    .preview iframe {
+      width: ${PREVIEW_RENDER_WIDTH}px;
+      height: 960px;
+      border: 0;
+      transform-origin: top left;
+      transform: scale(calc(340 / ${PREVIEW_RENDER_WIDTH}));
+      pointer-events: none;
+    }
+
+    .previewOverlay {
+      position: absolute;
+      inset: 0;
+      /* keeps the iframe inert and makes the whole card the drag handle */
+    }
+
+    .previewFallback {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      height: 100%;
+      color: #999;
+      font-size: 13px;
+    }
+
+    .previewFallback img {
+      width: 48px;
+      height: 48px;
+    }
+
+    .meta {
+      flex: 1 1 auto;
+      min-height: 0;
+      padding: 12px 14px 14px;
+      display: flex;
+      flex-direction: column;
+      gap: 4px;
+      overflow: hidden;
+    }
+
+    .titleRow {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 8px;
+    }
+
+    .titleRow strong {
+      font-size: 14.5px;
+    }
+
+    .badge {
+      flex-shrink: 0;
+      background: #ececff;
+      color: #4326d9;
+      font-size: 11px;
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+
+    .meta p {
+      margin: 0;
+      font-size: 12.5px;
+      color: #555;
+      line-height: 1.45;
+      display: -webkit-box;
+      -webkit-line-clamp: 2;
+      -webkit-box-orient: vertical;
+      overflow: hidden;
+    }
+  `;
+}
+
+customElements.define('ve-element-library', VeElementLibrary);
+
+/**
+ * Returns the singleton panel instance, mounting it on first use.
+ * @return {VeElementLibrary}
+ */
+export function getElementLibrary() {
+  let panel = document.querySelector('ve-element-library');
+  if (!panel) {
+    panel = document.createElement('ve-element-library');
+    document.body.appendChild(panel);
+  }
+  return panel;
+}
