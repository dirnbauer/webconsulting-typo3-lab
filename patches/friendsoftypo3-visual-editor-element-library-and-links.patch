+      padding: 5px 11px; border-radius: 999px; opacity: 0; pointer-events: none;
+      transition: opacity 0.16s ease, transform 0.16s ease; white-space: nowrap;
+    }
+    .card:hover .grabHint { opacity: 1; transform: translateX(-50%) translateY(0); }
+
+    /* card header (left-aligned): title and badges share one left rail with the
+       description below for an easy-to-scan, consistent column. The loupe lives
+       on the preview. */
+    .cardHead {
+      flex-shrink: 0;
+      display: flex; flex-direction: column; align-items: flex-start;
+      text-align: left; gap: 7px;
+      padding: 12px 16px 10px;
+    }
+
+    /* prominent, always-visible "enlarge" button anchored on the preview - plus
+       the whole preview opens the flyout on hover, so it is a big easy target
+       when fast-scrolling the list (no tiny icon to aim at) */
+    .previewLoupe {
+      position: absolute; z-index: 4; top: 8px; right: 8px;
+      display: inline-flex; align-items: center; justify-content: center;
+      width: 36px; height: 36px; padding: 0;
+      /* inverted look: transparent circle, lila ring + lila icon (the readable
+         accent follows light/dark mode) */
+      border: 2px solid var(--ve-accent-readable); border-radius: 999px;
+      background: transparent; color: var(--ve-accent-readable);
+      box-shadow: none;
+      cursor: pointer;
+      transition: transform 0.14s cubic-bezier(0.22, 1, 0.36, 1), background 0.12s ease, color 0.12s ease;
+    }
+    .card:hover .previewLoupe { transform: scale(1.1); }
+    .previewLoupe:hover { background: color-mix(in srgb, var(--ve-accent) 16%, transparent); transform: scale(1.16); }
+    .previewLoupe:focus-visible { outline: 2px solid var(--ve-accent-readable); outline-offset: 2px; }
+    /* signal the whole thumbnail is clickable-to-enlarge */
+    .preview { cursor: zoom-in; }
+
+    .cardTitle {
+      max-width: 100%;
+      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
+      font-size: 14.5px; font-weight: 700; line-height: 1.22; letter-spacing: -0.01em;
+    }
+    .cardBadges { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 6px; }
+
+    /* element description: left-aligned, regular weight, comfortable to read. It
+       lives in its own band, separated from the header by a single hairline. The
+       band height is capped so the preview stays the hero; a longer description
+       scrolls inside the band rather than being hard-cut, and the full text is
+       also shown in the enlarged-preview flyout on hover. */
+    .cardDesc {
+      flex-shrink: 0; margin: 0;
+      padding: 9px 16px 11px;
+      max-height: 5.4em; overflow-y: auto; overscroll-behavior: contain;
+      font-size: 12.5px; font-weight: 400; line-height: 1.5;
+      text-align: left;
+      color: color-mix(in srgb, var(--ve-panel-text) 66%, var(--ve-panel-muted));
+      border-top: 1px solid color-mix(in srgb, var(--ve-panel-text) 9%, var(--ve-panel-border));
+      scrollbar-width: thin; scrollbar-color: var(--ve-panel-border) transparent;
+    }
+    .cardDesc::-webkit-scrollbar { width: 7px; }
+    .cardDesc::-webkit-scrollbar-thumb {
+      background: var(--ve-panel-border); border-radius: 999px; border: 2px solid var(--ve-panel-surface);
+    }
+    /* highlights inside the short blurb: bold lifts to the full text colour so the
+       key term pops against the muted body; italic is the secondary accent */
+    .cardDesc strong { font-weight: 700; color: var(--ve-panel-text); }
+    .cardDesc em { font-style: italic; }
+    /* 1-column cards are taller -> give the description more room before it scrolls */
+    .panel.cols-1 .cardDesc { max-height: 8em; }
+
+    /* outline pills (category + demo-content status): border + text only, no
+       fill, so they read in both light and dark mode */
+    .pill {
+      display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0;
+      font-size: 10.5px; font-weight: 650; line-height: 1.45;
+      padding: 2px 8px; border-radius: 999px;
+      border: 1px solid color-mix(in srgb, currentColor 50%, transparent);
+      background: transparent;
+    }
+    .pill svg { width: 12px; height: 12px; flex-shrink: 0; }
+    .badge { color: var(--ve-accent-readable); text-transform: capitalize; }
+    .demoPill.is-on { color: var(--ve-accent-readable); }
+    .demoPill.is-off { color: var(--ve-panel-muted); }
+
+    /* enlarged preview flyout: hover-opened, sits in the canvas left of the
+       panel. Read-only - moving the pointer away closes it (not a drag source). */
+    .previewFlyoutWrap {
+      position: fixed; top: 50%; z-index: 100001;
+      right: calc(min(460px, 94vw) + 30px);
+      transform: translateY(-50%);
+      max-width: 92vw; max-height: 92vh;
+      animation: vePreviewIn 0.18s cubic-bezier(0.22, 1, 0.36, 1);
+    }
+    .previewFlyoutWrap.cols-2 { right: calc(min(600px, 94vw) + 30px); }
+    @keyframes vePreviewIn { from { opacity: 0; transform: translate(10px, -50%); } to { opacity: 1; transform: translate(0, -50%); } }
+
+    .previewFlyout {
+      display: flex; flex-direction: column;
+      max-width: 92vw; max-height: 92vh;
+      background: var(--ve-panel-surface); color: var(--ve-panel-text);
+      border: 1.5px solid color-mix(in srgb, var(--ve-accent) 55%, var(--ve-panel-border));
+      border-radius: var(--ve-card-radius); overflow: hidden;
+      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 0 1px color-mix(in srgb, var(--ve-accent) 22%, transparent);
+    }
+
+    /* short title bar above the rendered element: a "Vorschau / Preview" eyebrow,
+       the element name, and its category badge - tells you "what is it" at a glance */
+    .previewHead {
+      display: flex; align-items: center; gap: 9px;
+      padding: 9px 13px; flex-shrink: 0;
+      border-bottom: 1px solid var(--ve-panel-border);
+      background: linear-gradient(180deg, color-mix(in srgb, var(--ve-accent) 12%, var(--ve-panel-surface)), var(--ve-panel-surface));
+    }
+    .previewEyebrow {
+      flex-shrink: 0;
+      font-size: 10px; font-weight: 700; line-height: 1;
+      letter-spacing: 0.07em; text-transform: uppercase;
+      color: var(--ve-accent-readable);
+    }
+    .previewHead .previewTitle { flex: 1 1 auto; }
+
+    .previewStage {
+      position: relative; overflow: hidden; background: var(--ve-panel-bg);
+      width: 630px; height: 56vh;
+      transition: width 0.2s ease, height 0.2s ease;
+    }
+    .previewStage .previewSpinner { position: absolute; top: 50%; left: 50%; margin: -9px 0 0 -9px; }
+    .previewStage.loaded .previewSpinner { display: none; }
+    .previewFrame {
+      position: absolute; top: 0; left: 50%;
+      width: ${PREVIEW_RENDER_WIDTH}px; height: 1400px; border: 0;
+      transform-origin: top center;
+      transform: translateX(-50%) scale(calc(${PREVIEW_DISPLAY_WIDTH} * ${PREVIEW_ZOOM_FACTOR} / ${PREVIEW_RENDER_WIDTH}));
+      pointer-events: none; opacity: 0; transition: opacity 0.2s ease;
+    }
+    .previewFrame.ready { opacity: 1; }
+
+    /* caption below the stage now holds only the description; the title moved to
+       the .previewHead bar above the rendered element */
+    .previewCaption {
+      display: flex; flex-direction: column; gap: 5px;
+      padding: 9px 13px 11px; flex-shrink: 0;
+      border-top: 1px solid var(--ve-panel-border);
+      background: linear-gradient(0deg, color-mix(in srgb, var(--ve-accent) 8%, var(--ve-panel-surface)), var(--ve-panel-surface));
+    }
+    .previewTitle { font-size: 13.5px; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
+    /* the full, richer element description - the flyout is the "detailed" view,
+       so unlike the card it is not clamped: show the whole what / where / fields text */
+    .previewDesc {
+      margin: 0; font-size: 12px; line-height: 1.5;
+      color: color-mix(in srgb, var(--ve-panel-text) 74%, var(--ve-panel-muted));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .panel, .card, .thumb, .shimmer, .spinner, .preview iframe,
+      .previewFlyoutWrap, .previewFlyout, .previewStage, .previewFrame, .loupeButton { animation: none !important; transition: none !important; }
+    }
+  `;
+}
+
+customElements.define('ve-element-library', VeElementLibrary);
+
+/**
+ * Returns the singleton panel instance, mounting it on first use.
+ * @return {VeElementLibrary}
+ */
+export function getElementLibrary() {
+  let panel = document.querySelector('ve-element-library');
+  if (!panel) {
+    panel = document.createElement('ve-element-library');
+    document.body.appendChild(panel);
+  }
+  return panel;
+}
