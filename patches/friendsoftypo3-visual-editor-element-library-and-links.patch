+    this.#onPreviewSettled();
+  }
+
+  /**
+   * Some elements (announcement bars, single buttons, short teasers) render
+   * only a fraction of the preview box tall, leaving it mostly empty. Measure
+   * the real content height and, when it is much shorter than the box, zoom the
+   * thumbnail in (capped at PREVIEW_MAX_ZOOM) so small elements stay legible.
+   * Taller elements keep the base scale and show their top edge. The base scale
+   * is read from the already-applied CSS transform, so it stays correct for any
+   * column count. Same-origin preview, so contentDocument is readable; bail on
+   * any access error and keep the CSS scale.
+   * @param {HTMLIFrameElement} iframe
+   */
+  #fitPreview(iframe) {
+    let contentHeight = 0;
+    try {
+      const body = iframe.contentDocument && iframe.contentDocument.body;
+      if (body) {
+        contentHeight = body.scrollHeight || Math.round(body.getBoundingClientRect().height);
+      }
+    } catch (error) {
+      return;
+    }
+    if (contentHeight < 20) {
+      return;
+    }
+    let baseScale = 420 / PREVIEW_RENDER_WIDTH;
+    try {
+      const matrix = new DOMMatrixReadOnly(getComputedStyle(iframe).transform);
+      if (matrix.a > 0.01) {
+        baseScale = matrix.a;
+      }
+    } catch (error) {
+      // keep the fallback base scale
+    }
+    const fittedHeight = contentHeight * baseScale;
+    if (fittedHeight >= PREVIEW_BOX_HEIGHT * 0.85) {
+      return;
+    }
+    const zoom = Math.min(PREVIEW_MAX_ZOOM, (PREVIEW_BOX_HEIGHT * 0.92) / fittedHeight);
+    if (zoom > 1.02) {
+      iframe.style.transform = `scale(${baseScale * zoom})`;
+    }
+  }
+
+  #onPreviewSettled() {
+    this.previewInFlight = Math.max(0, this.previewInFlight - 1);
+    this.#pumpPreviews();
+  }
+
+  // --- enlarged preview (zoom) ----------------------------------------------
+
+  /**
+   * Opens the bigger preview overlay for a card. Lives on the card preview as a
+   * small magnify button; stops the event so it never starts a card drag.
+   * @param {Event} event
+   * @param {Object} item
+   */
