+   * setup module (window.veInfo.elementLibraryIncludeDemoDefault, default on).
+   * @return {boolean}
+   */
+  #resolveIncludeDemoDefault() {
+    const stored = elementLibraryIncludeDemo.get();
+    if (stored === true || stored === false) {
+      return stored;
+    }
+    return window.veInfo?.elementLibraryIncludeDemoDefault !== false;
+  }
+
+  /**
+   * Flipping the switch in the editor overrides the user default and persists,
+   * so the choice sticks across pages until changed again.
+   * @param {Event} event
+   */
+  #onDemoToggle(event) {
+    this.includeDemo = event.target.checked;
+    elementLibraryIncludeDemo.set(this.includeDemo);
+  }
+
+  toggle() {
+    this.open ? this.closePanel() : this.openPanel();
+  }
+
+  openPanel() {
+    this.open = true;
+    elementLibraryOpen.set(true);
+    this.dispatchEvent(new CustomEvent('ve-library-toggle', {detail: {open: true}, bubbles: true, composed: true}));
+    if (this.items.length === 0 && !this.loading) {
+      this.#load();
+    }
+  }
+
+  closePanel() {
+    this.#closeZoom();
+    this.open = false;
+    elementLibraryOpen.set(false);
+    this.dispatchEvent(new CustomEvent('ve-library-toggle', {detail: {open: false}, bubbles: true, composed: true}));
+  }
+
+  async #load() {
+    this.loading = true;
+    this.error = '';
+    try {
+      const response = await fetch(window.location.pathname + '?elementLibrary=1', {
+        headers: {'X-Request-Token': window.veInfo.token},
+      });
+      if (!response.ok) {
+        const body = await response.json().catch(() => ({}));
+        throw new Error(body.error || ('HTTP ' + response.status));
+      }
+      const data = await response.json();
+      this.items = data.elements || [];
+      this.categories = data.categories || [];
+    } catch (error) {
+      this.error = String(error.message || error);
+    } finally {
+      this.loading = false;
+    }
+  }
+
+  #onDragInProgressChange() {
+    // Slide out of the way while a drag is running so the drop zones are
+    // reachable. transform (not display) - hiding the drag source mid-drag
+    // would abort the native HTML5 drag operation.
+    this.collapsed = !!dragInProgressStore.value;
+  }
+
+  #toggleGroup(group) {
+    const next = new Set(this.selectedGroups);
+    next.has(group) ? next.delete(group) : next.add(group);
+    this.selectedGroups = next;
+  }
+
+  #clearFilters() {
+    this.selectedGroups = new Set();
+    this.searchTerm = '';
+  }
+
+  /**
+   * @param {DragEvent} event
+   * @param {Object} item
+   */
+  #cardDragStart(event, item) {
+    event.dataTransfer.effectAllowed = 'copyMove';
+    event.dataTransfer.clearData();
+
+    const info = {
+      table: 'tt_content',
+      // -1: never collides with a drop zone's own uid (0 = top zones)
+      uid: -1,
+      CType: item.cType,
+      libraryMode: this.includeDemo && item.demoUid > 0 ? 'copy' : 'new',
+      demoUid: item.demoUid,
