@@ -0,0 +1,83 @@
+import {css, html, LitElement} from 'lit';
+import {lll} from '@typo3/core/lit-helper.js';
+import {dragInProgressStore} from '@typo3/visual-editor/Frontend/stores/drag-store';
+import {getElementLibrary} from '@typo3/visual-editor/Frontend/components/ve-element-library';
+
+/**
+ * Floating "+" button (bottom right) that toggles the element library
+ * panel. Mounted by Frontend/index.js when the element library endpoint is
+ * enabled (window.veInfo.elementLibraryEnabled). Hidden during drags so it
+ * never covers a drop zone.
+ *
+ * @extends {HTMLElement}
+ */
+export class VeElementLibraryButton extends LitElement {
+  static properties = {
+    dragging: {type: Boolean, state: true, attribute: false},
+  };
+
+  constructor() {
+    super();
+    this.dragging = false;
+    this.onDragInProgressChange = this.#onDragInProgressChange.bind(this);
+  }
+
+  connectedCallback() {
+    super.connectedCallback();
+    dragInProgressStore.addEventListener('change', this.onDragInProgressChange);
+  }
+
+  disconnectedCallback() {
+    dragInProgressStore.removeEventListener('change', this.onDragInProgressChange);
+    super.disconnectedCallback();
+  }
+
+  #onDragInProgressChange() {
+    this.dragging = !!dragInProgressStore.value;
+  }
+
+  #toggle() {
+    getElementLibrary().toggle();
+  }
+
+  render() {
+    if (this.dragging) {
+      return html``;
+    }
+    const label = lll('frontend.library.open') || 'Add content from library';
+    return html`
+      <button type="button" class="fab" @click="${this.#toggle}" title="${label}" aria-label="${label}">+</button>
+    `;
+  }
+
+  static styles = css`
+    :host {
+      all: initial;
+    }
+
+    .fab {
+      position: fixed;
+      right: 24px;
+      bottom: 24px;
+      width: 52px;
+      height: 52px;
+      border-radius: 50%;
+      border: none;
+      background: #5432fe;
+      color: #fff;
+      font-size: 30px;
+      line-height: 1;
+      cursor: pointer;
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
+      z-index: 99999;
+      transition: transform 0.12s ease, background 0.12s ease;
+    }
+
+    .fab:hover {
+      background: #4326d9;
+      transform: scale(1.06);
+    }
+  `;
+}
+
+customElements.define('ve-element-library-button', VeElementLibraryButton);
diff --git a/Resources/Public/JavaScript/Frontend/components/ve-element-library.js b/Resources/Public/JavaScript/Frontend/components/ve-element-library.js
