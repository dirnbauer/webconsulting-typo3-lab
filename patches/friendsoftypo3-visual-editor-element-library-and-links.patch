+    try {
+      const doc = iframe.contentDocument;
+      if (!doc || doc.getElementById('ve-compact-preview')) {
+        return;
+      }
+      const style = doc.createElement('style');
+      style.id = 've-compact-preview';
+      // desiderio sections ship a big py-16/py-24; in a zoomed-out thumbnail that
+      // is mostly empty space, so tighten the section padding to keep the content
+      // (the actual "Gesamteindruck") prominent rather than the whitespace.
+      style.textContent =
+        '.desiderio-section{padding-block:14px!important}' +
+        'body>*:first-child{padding-block-start:14px!important}';
+      (doc.head || doc.documentElement).appendChild(style);
+    } catch (error) {
+      // cross-origin or detached - leave the preview untouched
