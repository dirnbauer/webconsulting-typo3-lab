+    }
+    document.removeEventListener('keydown', this.onZoomKeydown, true);
+  }
+
+  /** @param {KeyboardEvent} event */
+  #onZoomKeydown(event) {
+    if (event.key === 'Escape') {
+      event.preventDefault();
+      event.stopPropagation();
+      this.#closeZoom();
+    }
+  }
+
+  /**
+   * Sizes the enlarged preview once its iframe has loaded: render the element
+   * at PREVIEW_ZOOM_FACTOR x the thumbnail scale, then clamp that scale so the
+   * full element fits the editing viewport - so this extra preview never needs
+   * a scrollbar. The stage box is set to the exact scaled content size.
+   * Same-origin preview, so contentDocument is readable; fall back to the CSS
+   * defaults on any access error.
+   * @param {Event} event iframe load event
+   */
+  #onZoomLoad(event) {
+    const iframe = event.target;
+    const stage = iframe.closest('.zoomStage');
+    let contentHeight = 0;
+    try {
+      const body = iframe.contentDocument && iframe.contentDocument.body;
+      if (body) {
+        contentHeight = body.scrollHeight || Math.round(body.getBoundingClientRect().height);
+      }
+    } catch (error) {
+      // keep the CSS fallback size
+    }
+    if (contentHeight < 20) {
+      contentHeight = Math.round(PREVIEW_RENDER_WIDTH * 0.5);
+    }
