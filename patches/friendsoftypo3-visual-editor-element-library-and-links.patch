+        </div>
+        <div class="meta">
+          <div class="titleRow">
+            <strong>${item.title}</strong>
+            <span class="badge">${item.group}</span>
+          </div>
+          <p>${item.description}</p>
+          <p class="demoNote">
+            <svg class="demoNote__icon" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
+              <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4"/>
