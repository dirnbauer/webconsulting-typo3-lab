diff --git a/Resources/Public/JavaScript/Frontend/components/ve-editable-link.js b/Resources/Public/JavaScript/Frontend/components/ve-editable-link.js
new file mode 100644
index 0000000..68fcd30
--- /dev/null
+++ b/Resources/Public/JavaScript/Frontend/components/ve-editable-link.js
@@ -0,0 +1,144 @@
+import {css, html, LitElement} from 'lit';
+import {lll} from '@typo3/core/lit-helper.js';
+import {sendMessage, onMessage} from '@typo3/visual-editor/Shared/iframe-messaging';
+import {dataHandlerStore} from '@typo3/visual-editor/Frontend/stores/data-handler-store';
+import '@typo3/visual-editor/Frontend/components/ve-icon';
+
+/**
+ * Inline editor for pure TCA type=link fields: renders a link icon next to
+ * the (separately editable or derived) link text. Clicking it asks the
+ * backend frame to open the TYPO3 link browser; the chosen typolink value
+ * travels back via the linkBrowserSetLink message and is staged on the
+ * editor's pending change list (written with the next explicit save, like an
+ * inline text edit) - never saved to the database on its own.
+ *
+ * Rendered by the ve:render.link ViewHelper in edit mode only.
+ *
+ * @extends {HTMLElement}
+ */
+export class VeEditableLink extends LitElement {
+  static properties = {
+    table: {type: String},
+    uid: {type: Number},
+    field: {type: String},
+    value: {type: String},
+    name: {type: String},
+    linkBrowserUrl: {type: String},
+  };
+
+  constructor() {
+    super();
+    this.value = this.getAttribute('value') ?? '';
+    // The link value present when the editor loaded: the baseline the change
+    // list diffs against, so reverting to it clears the pending change.
+    this.valueInitial = this.value;
+  }
+
+  firstUpdated() {
+    dataHandlerStore.setInitialData(this.table, this.uid, this.field, this.valueInitial);
+  }
+
+  #openLinkBrowser() {
+    const currentValue = dataHandlerStore.data?.[this.table]?.[this.uid]?.[this.field] ?? this.value;
+    const src = this.linkBrowserUrl + '&P%5BcurrentValue%5D=' + encodeURIComponent(currentValue);
+    pendingLinkEdit = this;
+    sendMessage('openLinkBrowser', {
+      src,
+      title: lll('frontend.editLink') || 'Edit link',
+    });
+  }
+
+  /**
+   * Stages the typolink chosen in the link browser on the editor's pending
+   * change list via dataHandlerStore.setData - exactly like an inline text
+   * edit. It is written to the database only on the next explicit save; setting
+   * a link must never force an immediate save of all other pending changes.
+   * @param {string} typolink
+   */
+  applyLink(typolink) {
+    if (typolink === undefined || typolink === null || typolink === this.value) {
+      return;
+    }
+
+    dataHandlerStore.setData(this.table, this.uid, this.field, typolink);
+    this.value = typolink;
+  }
+
+  render() {
+    // experimental, per-user opt-in: render nothing when link editing is off
+    if (!window.veInfo?.elementLibraryLinks) {
+      return html``;
+    }
+    const title = (lll('frontend.editLink') || 'Edit link') + (this.name ? ': ' + this.name : '');
+    return html`
+      <button type="button" class="linkButton" @click="${this.#openLinkBrowser}" title="${title}" aria-label="${title}">
+        <ve-icon name="actions-link" width="1em"></ve-icon>
+      </button>
+    `;
+  }
+
+  static styles = css`
+    :host {
+      display: inline-block;
+      vertical-align: baseline;
+      /* Blend the brand accent toward the inherited text colour (currentColor)
+         so the control follows the surrounding template section's own light/dark
+         style: a lighter purple on dark sections, a darker purple on light ones.
+         This works regardless of how the section sets its scheme (.dark class,
+         local --foreground tokens, etc.) because it just follows the text. */
+      --ve-accent: color-mix(in srgb, var(--ve-accent-color, #7c5ac4) 70%, currentColor);
+      --ve-accent-fill: 16%;
+    }
+
+    .linkButton {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      /* WCAG 2.2 SC 2.5.8 Target Size (Minimum, AA): the clickable target
+         must be at least 24x24 CSS px. 1.7em scales the button with the
+         surrounding text, but border-box + a 24px floor guarantees the
+         bounding box never drops below the threshold next to small text. */
+      box-sizing: border-box;
+      width: 1.7em;
+      height: 1.7em;
+      min-width: 24px;
+      min-height: 24px;
+      padding: 0;
+      margin-inline-start: 0.3em;
+      border: 1px solid color-mix(in srgb, var(--ve-accent) 55%, transparent);
+      border-radius: 0.35em;
+      background: color-mix(in srgb, var(--ve-accent) var(--ve-accent-fill), transparent);
+      color: var(--ve-accent);
+      cursor: pointer;
+      transition: background 0.12s ease, transform 0.12s ease, box-shadow 0.12s ease;
+      animation: linkPulse 2.4s ease-in-out 3;
+    }
+
+    .linkButton:hover {
+      background: color-mix(in srgb, var(--ve-accent) 28%, transparent);
+      transform: translateY(-1px);
+      box-shadow: 0 3px 10px color-mix(in srgb, var(--ve-accent) 40%, transparent);
+    }
+
+    @keyframes linkPulse {
+      0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ve-accent) 40%, transparent); }
+      50% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--ve-accent) 0%, transparent); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .linkButton { animation: none; transition: none; }
+    }
+  `;
+}
+
+/** @type {VeEditableLink|null} */
+let pendingLinkEdit = null;
+
+onMessage('linkBrowserSetLink', (detail) => {
+  if (pendingLinkEdit && detail) {
+    pendingLinkEdit.applyLink(detail.value);
+    pendingLinkEdit = null;
+  }
+});
+
+customElements.define('ve-editable-link', VeEditableLink);
diff --git a/Resources/Public/JavaScript/Frontend/components/ve-element-library-button.js b/Resources/Public/JavaScript/Frontend/components/ve-element-library-button.js
new file mode 100644
index 0000000..3dc7fa1
--- /dev/null
+++ b/Resources/Public/JavaScript/Frontend/components/ve-element-library-button.js
@@ -0,0 +1,115 @@
+import {css, html, LitElement} from 'lit';
+import {lll} from '@typo3/core/lit-helper.js';
+import {dragInProgressStore} from '@typo3/visual-editor/Frontend/stores/drag-store';
+import {getElementLibrary} from '@typo3/visual-editor/Frontend/components/ve-element-library';
+import {elementLibraryOpen} from '@typo3/visual-editor/Shared/local-stores';
+
+/**
+ * Floating action button that toggles the element library panel. Anchored at
+ * the top of the editing canvas, on top of the content elements. Reflects the
+ * open/closed state (+ rotates to x) and hides while a drag is running so it
+ * never covers a drop zone. Accent colour comes from the backend theme token
+ * (--ve-accent-color, provided by the backend bridge) with a sane fallback.
+ *
+ * @extends {HTMLElement}
+ */
+export class VeElementLibraryButton extends LitElement {
+  static properties = {
+    dragging: {type: Boolean, state: true, attribute: false},
+    open: {type: Boolean, state: true, attribute: false},
+  };
+
+  constructor() {
+    super();
+    this.dragging = false;
+    this.open = !!elementLibraryOpen.get();
+    this.onDragInProgressChange = this.#onDragInProgressChange.bind(this);
+    this.onLibraryToggle = this.#onLibraryToggle.bind(this);
+  }
+
+  connectedCallback() {
+    super.connectedCallback();
+    dragInProgressStore.addEventListener('change', this.onDragInProgressChange);
+    document.addEventListener('ve-library-toggle', this.onLibraryToggle);
+  }
+
+  disconnectedCallback() {
+    dragInProgressStore.removeEventListener('change', this.onDragInProgressChange);
+    document.removeEventListener('ve-library-toggle', this.onLibraryToggle);
+    super.disconnectedCallback();
+  }
+
+  #onDragInProgressChange() {
+    this.dragging = !!dragInProgressStore.value;
+  }
+
+  #onLibraryToggle(event) {
+    this.open = !!event.detail?.open;
+  }
+
+  #toggle() {
+    getElementLibrary().toggle();
+  }
+
+  render() {
+    if (this.dragging) {
+      return html``;
+    }
+    const label = this.open
+      ? (lll('frontend.library.close') || 'Close library')
+      : (lll('frontend.library.open') || 'Add content from library');
+    return html`
+      <button type="button" class="fab ${this.open ? 'open' : ''}" @click="${this.#toggle}" title="${label}" aria-label="${label}" aria-pressed="${this.open}">
+        <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
+          <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
+        </svg>
+      </button>
+    `;
+  }
+
+  static styles = css`
+    :host {
+      --ve-accent: var(--ve-accent-color, #7c5ac4);
+      --ve-accent-contrast: #ffffff;
+      /* halo ring around the FAB: white on a dark canvas, dark on light */
+      --ve-fab-ring: rgba(255, 255, 255, 0.92);
+      font-family: var(--typo3-font-family-sans, system-ui, -apple-system, sans-serif);
+    }
+
+    .fab {
+      position: fixed;
+      top: 14px;
+      right: 18px;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 46px;
+      height: 46px;
+      padding: 0;
+      border-radius: 50%;
+      border: none;
+      background: var(--ve-accent);
+      color: var(--ve-accent-contrast);
+      cursor: pointer;
+      box-shadow: 0 0 0 2px var(--ve-fab-ring), 0 8px 22px color-mix(in srgb, var(--ve-accent) 50%, transparent), 0 2px 6px rgba(0,0,0,0.25);
+      z-index: 100001;
+      transition: transform 0.14s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.14s ease, background 0.14s ease;
+    }
+    .fab:hover { transform: translateY(-1px) scale(1.06); box-shadow: 0 0 0 2px var(--ve-fab-ring), 0 12px 28px color-mix(in srgb, var(--ve-accent) 55%, transparent); }
+    .fab:active { transform: translateY(0) scale(0.98); }
+
+    .icon { transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1); }
+    .fab.open .icon { transform: rotate(135deg); }
+    .fab.open { background: color-mix(in srgb, var(--ve-accent) 78%, #000); }
+
+    @media (prefers-color-scheme: light) {
+      :host { --ve-fab-ring: rgba(20, 20, 26, 0.5); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .fab, .icon { transition: none !important; }
+    }
+  `;
+}
+
+customElements.define('ve-element-library-button', VeElementLibraryButton);
