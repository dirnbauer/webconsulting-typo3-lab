+          </div>
+
+          ${window.veInfo?.elementLibraryShowDemoSwitch !== false ? html`
+            <label class="demoSwitch ${this.includeDemo ? 'on' : ''}">
+              <span class="demoSwitch__control">
+                <input
+                  type="checkbox"
+                  .checked="${this.includeDemo}"
+                  @change="${this.#onDemoToggle}"
