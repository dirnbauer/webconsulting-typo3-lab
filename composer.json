		"lochmueller/staticfilecache": "^16.1",
		"netresearch/nr-llm": "^0.25",
		"netresearch/nr-vault": "^0.12",
		"netresearch/t3-cowriter": "^3.5",
		"paragonie/sodium_compat": "^2.5.2",
		"praetorius/vite-asset-collector": "^1.18",
		"sgalinski/sg-apicore": "dev-main",
		"studiomitte/friendlycaptcha": "^14.0@dev",
		"studiomitte/solr-numbered-pagination": "dev-main",
		"supseven/inline-page-module": "^4.0",
		"t3g/blog": "^15.0.3",
		"typo3/class-alias-loader": "^2.0.1",
		"typo3/cms-adminpanel": "^14.3.6",
		"typo3/cms-backend": "^14.3.6",
		"typo3/cms-belog": "^14.3.6",
		"typo3/cms-beuser": "^14.3.6",
		"typo3/cms-core": "^14.3.6",
		"typo3/cms-dashboard": "^14.3.6",
		"typo3/cms-extbase": "^14.3.6",
		"typo3/cms-extensionmanager": "^14.3.6",
		"typo3/cms-felogin": "^14.3.6",
		"typo3/cms-filelist": "^14.3.6",
		"typo3/cms-fluid": "^14.3.6",
		"typo3/cms-fluid-styled-content": "^14.3.6",
		"typo3/cms-form": "^14.3.6",
