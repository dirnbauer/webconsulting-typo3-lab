{
	"name": "webconsulting/typo3-lab",
	"description": "Webconsulting TYPO3 Lab - DDEV-powered TYPO3 feature lab for experiments, demos, integrations and modern CMS workflows",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"cweagans/composer-patches": true,
			"php-http/discovery": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.4.22"
		},
		"use-github-api": false,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true
	},
	"repositories": [
		{
			"name": "typo3-agent-phpspreadsheet5-compatibility",
			"type": "package",
			"package": [
				{
					"name": "hn/typo3-agent",
					"version": "v0.0.3",
					"description": "TYPO3 extension that integrates an AI agent directly into TYPO3, using the MCP ToolRegistry for native tool execution with an OpenAI-compatible LLM API",
					"type": "typo3-cms-extension",
					"license": [
						"GPL-2.0-or-later"
					],
					"source": {
						"url": "https://github.com/hauptsacheNet/typo3-agent.git",
						"type": "git",
						"reference": "91934338dcc365ec3f82d2c5187b9810521f56e7"
					},
					"dist": {
						"url": "https://api.github.com/repos/hauptsacheNet/typo3-agent/zipball/91934338dcc365ec3f82d2c5187b9810521f56e7",
						"type": "zip",
						"shasum": "",
						"reference": "91934338dcc365ec3f82d2c5187b9810521f56e7"
					},
					"require": {
						"php": ">=8.1.0",
						"hn/typo3-mcp-server": "*",
						"phpoffice/phppresentation": "^1.1",
						"phpoffice/phpspreadsheet": "^3.10 || ^5.0",
						"phpoffice/phpword": "^1.4",
						"smalot/pdfparser": "^2.12",
						"typo3/cms-backend": "^13.4|^14.3",
						"typo3/cms-core": "^13.4|^14.3",
						"typo3/cms-workspaces": "^13.4 || ^14.3"
					},
					"autoload": {
						"psr-4": {
							"Hn\\Agent\\": "Classes/"
						}
					},
					"extra": {
						"typo3/cms": {
							"extension-key": "agent"
						}
					}
				},
				{
					"name": "phpoffice/phppresentation",
					"version": "1.2.0",
					"description": "PHPPresentation - Read, Create and Write Presentations documents in PHP",
					"type": "library",
					"license": [
						"LGPL-3.0-only"
					],
					"source": {
						"url": "https://github.com/PHPOffice/PHPPresentation.git",
						"type": "git",
						"reference": "b9cdcd413e2d463ba3198f912f32716adc88f340"
					},
					"dist": {
						"url": "https://api.github.com/repos/PHPOffice/PHPPresentation/zipball/b9cdcd413e2d463ba3198f912f32716adc88f340",
						"type": "zip",
						"shasum": "",
						"reference": "b9cdcd413e2d463ba3198f912f32716adc88f340"
					},
					"require": {
						"php": "^7.1|^8.0",
						"ext-xml": "*",
						"ext-zip": "*",
						"phpoffice/common": "^1",
						"phpoffice/phpspreadsheet": "^1.9 || ^2.0 || ^3.0 || ^4.0 || ^5.0"
					},
					"autoload": {
						"psr-4": {
							"PhpOffice\\PhpPresentation\\": "src/PhpPresentation/"
						}
					}
				}
			]
		},
		{
			"name": "innesto",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/innesto"
		},
		{
