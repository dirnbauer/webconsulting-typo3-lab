		"typo3/cms-redirects": "^14.3.6",
		"typo3/cms-rte-ckeditor": "^14.3.6",
		"typo3/cms-scheduler": "^14.3.6",
		"typo3/cms-seo": "^14.3.6",
		"typo3/cms-setup": "^14.3.6",
		"typo3/cms-styleguide": "^14.3.6",
		"typo3/cms-sys-note": "^14.3.6",
		"typo3/cms-tstemplate": "^14.3.6",
		"typo3/cms-viewpage": "^14.3.6",
		"typo3/cms-webhooks": "^14.3.6",
		"typo3/cms-workspaces": "^14.3.6",
		"typo3/theme-camino": "^14.3.6",
		"wapplersystems/multisite-belogin": "^14.1",
		"webconsulting/agent-nexus": "^2.0.2",
		"webconsulting/agentation": "^1.1",
		"webconsulting/astryx-typo3": "^1.0.2",
		"webconsulting/desiderio": "^4.0.6",
		"webconsulting/docx-editor": "dev-main",
		"webconsulting/flue": "^0.2",
		"webconsulting/image-workbench": "dev-main",
		"webconsulting/innesto": "^2.0",
		"webconsulting/records-list-examples": "^1.1",
		"webconsulting/records-list-types": "^1.0.7",
		"webconsulting/site-package": "^14.3",
		"webconsulting/skillflow": "dev-main",
		"webconsulting/skillspector": "dev-main",
		"webconsulting/typo3-abilities": "dev-main",
		"webconsulting/typo3-ai-chat": "dev-main",
