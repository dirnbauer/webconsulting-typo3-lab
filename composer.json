{
	"name": "webconsulting/typo3-lab",
	"description": "Webconsulting TYPO3 Lab - DDEV-powered TYPO3 feature lab for experiments, demos, integrations and modern CMS workflows",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"cweagans/composer-patches": true,
			"php-http/discovery": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.5.12"
		},
		"use-github-api": false,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true
	},
	"repositories": [
		{
			"name": "in2code",
			"type": "composer",
			"url": "https://in2code.repo.packagist.com/webconsulting/",
			"only": ["in2code/powermail", "in2code/powermail_cond"]
		},
		{
			"name": "poppy",
			"type": "git",
			"url": "git@gitlab.webconsulting.at:extensions/typo3-poppy.git"
		},
		{
			"name": "innesto",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/innesto"
		},
		{
			"name": "image-workbench",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-image-workbench.git"
		},
		{
			"type": "path",
			"url": "packages/site_package",
			"options": {
				"symlink": true,
				"versions": {
					"webconsulting/site-package": "14.3.6"
				}
			}
		},
		{
			"name": "astryx-typo3",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/astryx-typo3.git"
		},
		{
			"name": "agent-nexus",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-agent-nexus.git"
		},
		{
			"name": "visual-editor-enhancements",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-visual-editor-enhancements.git"
		},
		{
			"name": "skillflow",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/skillflow.git"
		},
		{
			"name": "skillspector",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-skillspector.git"
		},
		{
			"name": "typo3-abilities",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-abilities.git"
		},
		{
			"name": "typo3-llms-txt",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-llms-txt.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-agentation.git"
		},
		{
			"name": "records-list-examples",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-records-list-examples.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/desiderio.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-mcp-server.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-records-list-types.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-x402-paywall.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/workos.git",
			"no-api": true
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-webcon-easy-workspace.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-docx.git"
		},
		{
			"name": "friendlycaptcha",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/friendlycaptcha-typo3.git"
		},
		{
			"name": "solr-numbered-pagination",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/solr_numbered_pagination.git"
		},
		{
			"name": "webcon-jev",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-webcon-jev.git"
		},
		{
			"type": "git",
			"url": "git@gitlab.webconsulting.at:extensions/typo3-webcon-templates.git",
			"name": "webcon-templates"
		}
	],
	"require": {
		"php": "^8.5",
		"apache-solr-for-typo3/solr": "^14.0.2",
		"cweagans/composer-patches": "^2.0",
		"friendsoftypo3/tt-address": "^10.0.1",
		"friendsoftypo3/visual-editor": "^1.11.1",
		"georgringer/context-edit-records": "^1.0",
		"georgringer/news": "^14.1.2",
		"georgringer/numbered-pagination": "^2.2",
		"hn/typo3-mcp-server": "^0.9.8",
		"in2code/powermail": "^14.2",
		"in2code/powermail_cond": "^14.0.1",
		"lochmueller/staticfilecache": "^16.2.0",
		"netresearch/nr-browser-ai": "^0.9.0",
		"netresearch/nr-landingpage": "^0.8.2",
		"netresearch/nr-llm": "^0.51.1",
		"netresearch/nr-mcp-agent": "^0.39.3",
		"netresearch/nr-vault": "^1.10",
		"netresearch/t3-cowriter": "^3.28.8",
		"paragonie/sodium_compat": "^2.5.2",
		"praetorius/vite-asset-collector": "^1.18.4",
		"sgalinski/sg-apicore": "^3.1.10",
		"studiomitte/friendlycaptcha": "~2.3.0.4",
		"studiomitte/solr-numbered-pagination": "^1.0.5",
		"supseven/inline-page-module": "^4.0.5",
		"t3g/blog": "^14.0.1",
		"typo3/class-alias-loader": "^2.0.1",
		"typo3/cms-adminpanel": "^14.3.12",
		"typo3/cms-backend": "^14.3.12",
		"typo3/cms-belog": "^14.3.12",
		"typo3/cms-beuser": "^14.3.12",
		"typo3/cms-core": "^14.3.12",
		"typo3/cms-dashboard": "^14.3.12",
		"typo3/cms-extbase": "^14.3.12",
		"typo3/cms-extensionmanager": "^14.3.12",
		"typo3/cms-felogin": "^14.3.12",
		"typo3/cms-filelist": "^14.3.12",
		"typo3/cms-fluid": "^14.3.12",
		"typo3/cms-fluid-styled-content": "^14.3.12",
		"typo3/cms-form": "^14.3.12",
		"typo3/cms-frontend": "^14.3.12",
		"typo3/cms-impexp": "^14.3.12",
		"typo3/cms-info": "^14.3.12",
		"typo3/cms-install": "^14.3.12",
		"typo3/cms-lowlevel": "^14.3.12",
		"typo3/cms-reactions": "^14.3.12",
		"typo3/cms-recycler": "^14.3.12",
		"typo3/cms-redirects": "^14.3.12",
		"typo3/cms-rte-ckeditor": "^14.3.12",
		"typo3/cms-scheduler": "^14.3.12",
		"typo3/cms-seo": "^14.3.12",
		"typo3/cms-styleguide": "^14.3.12",
		"typo3/cms-sys-note": "^14.3.12",
		"typo3/cms-tstemplate": "^14.3.12",
		"typo3/cms-viewpage": "^14.3.12",
		"typo3/cms-webhooks": "^14.3.12",
		"typo3/cms-workspaces": "^14.3.12",
		"typo3/theme-camino": "^14.3.12",
		"wapplersystems/multisite-belogin": "^14.2.0",
		"webconsulting/agent-nexus": "^4.1.3",
		"webconsulting/agentation": "^1.5.2",
		"webconsulting/astryx-typo3": "^2.6.3",
		"webconsulting/desiderio": "^4.36.0",
		"webconsulting/docx-editor": "^2.5.4",
		"webconsulting/image-workbench": "^0.3.4",
		"webconsulting/innesto": "^2.3.4",
		"webconsulting/records-list-examples": "^2.0.3",
		"webconsulting/records-list-types": "^2.0.3",
		"webconsulting/site-package": "^14.3.6",
		"webconsulting/skillflow": "^1.10.1",
		"webconsulting/skillspector": "^1.2.4",
		"webconsulting/typo3-abilities": "^1.3.2",
		"webconsulting/typo3-llms-txt": "^1.2.2",
		"webconsulting/typo3-poppy": "^0.2.3",
		"webconsulting/typo3-x402-paywall": "^1.4.2",
		"webconsulting/visual-editor-enhancements": "^1.7.0",
		"webconsulting/webcon-easy-workspace": "^1.11.2",
		"webconsulting/webcon-jev": "^0.3.2",
		"webconsulting/webcon-templates": "^1.0.4",
		"webconsulting/workos-auth": "^2.4.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.3.7",
		"phpunit/phpunit": "^13.4.8",
		"saschaegerer/phpstan-typo3": "^3.1"
	},
	"extra": {
		"composer-exit-on-patch-failure": true,
		"patches": {
			"apache-solr-for-typo3/solr": {
				"Align legacy backend styles with TYPO3 v14 design tokens": "patches/apache-solr-for-typo3-solr-typo3-v14-backend-styles.patch"
			},
			"in2code/powermail": {
				"Accept the default-language form of a translated plugin": "patches/in2code-powermail-translated-plugin-form.patch",
				"Render the Google Ads snippet only when the Marketing set enables it": "patches/in2code-powermail-adwords-constant.patch"
			},
			"in2code/powermail_cond": {
				"Let extensions evaluate their own rule operators": "patches/in2code-powermail-cond-evaluate-rule-event.patch",
				"Provide the Powermail Conditions site set and the prerender flag": "patches/in2code-powermail-cond-site-set-prerender.patch",
				"Wait for the condition endpoint and announce processed responses": "patches/in2code-powermail-cond-frontend-wait-and-processed-event.patch"
			},
			"netresearch/nr-vault": {
				"Distinguish missing current credentials from historical deleted inventory": "patches/netresearch-nr-vault-inventory-lifecycle.patch"
			},
			"t3g/blog": {
				"Modernize blog backend, plugin, and record icons for TYPO3 v14": "patches/t3g-blog-typo3-v14-icons.patch"
			},
			"webconsulting/desiderio": {
				"Show server validation errors when the client summary is disabled": "patches/webconsulting-desiderio-powermail-server-errors.patch"
			}
		}
	},
	"scripts": {
		"lab-relink": "sh -c 'test -s .lab-links || exit 0; bash Build/Scripts/lab-link.sh --relink || echo \"lab-relink failed: run Build/Scripts/lab-link.sh --relink\"'",
		"post-install-cmd": [
			"@lab-relink"
		],
		"post-update-cmd": [
			"@lab-relink"
		]
	},
	"scripts-descriptions": {
		"lab-relink": "Re-link the development clones recorded in .lab-links (Build/Scripts/lab-link.sh) that a Composer run replaced with their dist zip. A no-op without that file, so CI and the Docker build are unaffected."
	}
}
