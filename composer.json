{
	"name": "webconsulting/typo3-lab",
	"description": "Webconsulting TYPO3 Lab - DDEV-powered TYPO3 feature lab for experiments, demos, integrations and modern CMS workflows",
	"license": "GPL-2.0-or-later",
	"type": "project",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"cweagans/composer-patches": true,
			"php-http/discovery": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.4.22"
		},
		"use-github-api": false,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true
	},
	"repositories": [
		{
			"name": "innesto",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/innesto"
		},
		{
			"name": "image-workbench",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-image-workbench.git"
		},
		{
			"type": "path",
			"url": "packages/site_package",
			"options": {
				"symlink": true,
				"versions": {
					"webconsulting/site-package": "14.3.5"
				}
			}
		},
		{
			"name": "astryx-typo3",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/astryx-typo3.git"
		},
		{
			"name": "agent-nexus",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-agent-nexus.git"
		},
		{
			"name": "visual-editor-enhancements",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-visual-editor-enhancements.git"
		},
		{
			"name": "skillflow",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/skillflow.git"
		},
		{
			"name": "skillspector",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-skillspector.git"
		},
		{
			"name": "typo3-abilities",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-abilities.git"
		},
		{
			"name": "typo3-llms-txt",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-llms-txt.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-agentation.git"
		},
		{
			"name": "records-list-examples",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-records-list-examples.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/desiderio.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-mcp-server.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/powermail.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-records-list-types.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-x402-paywall.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/netresearch/t3x-nr-llm.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/netresearch/t3x-nr-vault.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/netresearch/t3x-cowriter.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/workos.git",
			"no-api": true
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-webcon-easy-workspace.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-docx.git"
		},
		{
			"name": "friendlycaptcha",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/friendlycaptcha-typo3.git"
		},
		{
			"name": "solr-numbered-pagination",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/solr_numbered_pagination.git"
		},
		{
			"name": "powermail-cond",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/powermail_cond.git"
		},
		{
			"name": "webcon-jev",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-webcon-jev.git"
		},
		{
			"name": "typo3-ai-assistant",
			"type": "vcs",
			"url": "https://github.com/dirnbauer/typo3-ai-assistant.git"
		}
	],
	"require": {
		"php": "^8.4",
		"apache-solr-for-typo3/solr": "^14.0.2",
		"cweagans/composer-patches": "^2.0",
		"friendsoftypo3/tt-address": "^10.0.1",
		"friendsoftypo3/visual-editor": "^1.10.3",
		"georgringer/context-edit-records": "^1.0",
		"georgringer/news": "^14.1",
		"georgringer/numbered-pagination": "^2.2",
		"hn/typo3-mcp-server": "^0.9.3",
		"in2code/powermail": "~14.0.3.3",
		"in2code/powermail_cond": "dev-typo3-v14",
		"lochmueller/staticfilecache": "^16.1.2",
		"netresearch/nr-llm": "^0.35",
		"netresearch/nr-vault": "^0.16",
		"netresearch/t3-cowriter": "^3.6.8",
		"paragonie/sodium_compat": "^2.5.2",
		"praetorius/vite-asset-collector": "^1.18.3",
		"sgalinski/sg-apicore": "^3.1.2",
		"studiomitte/friendlycaptcha": "~2.3.0.1",
		"studiomitte/solr-numbered-pagination": "dev-main",
		"supseven/inline-page-module": "^4.0.3",
		"t3g/blog": "^14.0.1",
		"typo3/class-alias-loader": "^2.0.1",
		"typo3/cms-adminpanel": "^14.3.7",
		"typo3/cms-backend": "^14.3.7",
		"typo3/cms-belog": "^14.3.7",
		"typo3/cms-beuser": "^14.3.7",
		"typo3/cms-core": "^14.3.7",
		"typo3/cms-dashboard": "^14.3.7",
		"typo3/cms-extbase": "^14.3.7",
		"typo3/cms-extensionmanager": "^14.3.7",
		"typo3/cms-felogin": "^14.3.7",
		"typo3/cms-filelist": "^14.3.7",
		"typo3/cms-fluid": "^14.3.7",
		"typo3/cms-fluid-styled-content": "^14.3.7",
		"typo3/cms-form": "^14.3.7",
		"typo3/cms-frontend": "^14.3.7",
		"typo3/cms-impexp": "^14.3.7",
		"typo3/cms-info": "^14.3.7",
		"typo3/cms-install": "^14.3.7",
		"typo3/cms-lowlevel": "^14.3.7",
		"typo3/cms-reactions": "^14.3.7",
		"typo3/cms-recycler": "^14.3.7",
		"typo3/cms-redirects": "^14.3.7",
		"typo3/cms-rte-ckeditor": "^14.3.7",
		"typo3/cms-scheduler": "^14.3.7",
		"typo3/cms-seo": "^14.3.7",
		"typo3/cms-styleguide": "^14.3.7",
		"typo3/cms-sys-note": "^14.3.7",
		"typo3/cms-tstemplate": "^14.3.7",
		"typo3/cms-viewpage": "^14.3.7",
		"typo3/cms-webhooks": "^14.3.7",
		"typo3/cms-workspaces": "^14.3.7",
		"typo3/theme-camino": "^14.3.7",
		"wapplersystems/multisite-belogin": "^14.1.2",
		"webconsulting/agent-nexus": "^4.0.3",
		"webconsulting/agentation": "^1.5",
		"webconsulting/astryx-typo3": "^2.2.0",
		"webconsulting/desiderio": "^4.4.1",
		"webconsulting/docx-editor": "^2.4",
		"webconsulting/image-workbench": "^0.3",
		"webconsulting/innesto": "^2.3",
		"webconsulting/records-list-examples": "^1.5",
		"webconsulting/records-list-types": "^1.3",
		"webconsulting/site-package": "^14.3.5",
		"webconsulting/skillflow": "^1.8.1",
		"webconsulting/skillspector": "^1.2",
		"webconsulting/typo3-abilities": "^1.3",
		"webconsulting/typo3-ai-assistant": "^2.0",
		"webconsulting/typo3-llms-txt": "^1.2",
		"webconsulting/typo3-x402-paywall": "^1.4",
		"webconsulting/visual-editor-enhancements": "^1.2",
		"webconsulting/webcon-easy-workspace": "^1.7.2",
		"webconsulting/webcon-jev": "^0.2.4",
		"webconsulting/workos-auth": "^2.3.1"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^13.3",
		"saschaegerer/phpstan-typo3": "^3.1"
	},
	"extra": {
		"composer-exit-on-patch-failure": true,
		"patches": {
			"apache-solr-for-typo3/solr": {
				"Align legacy backend styles with TYPO3 v14 design tokens": "patches/apache-solr-for-typo3-solr-typo3-v14-backend-styles.patch"
			},
			"typo3/cms-core": {
				"Guard workspace move-pointer overlay when the live record is missing": "patches/typo3-cms-core-fix-workspace-move-pointer-missing-live-record.patch"
			}
		}
	}
}
