includes:
    - ../../vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
    # Level 8 everywhere, not max: the one baseline the user chose for every own
    # extension and this lab (strict nulls and types, without max's mixed-type rules).
    level: 8
    phpVersion: 80400
    paths:
        - ../../packages/site_package/Classes
        - ../../packages/site_package/Configuration/RequestMiddlewares.php
        - ../../packages/site_package/Build/Scripts/lint-copy.php
    excludePaths:
        analyseAndScan:
            - ../../vendor
            - ../../var (?)
            - ../../public (?)
            - ../../node_modules (?)
    tmpDir: ../../var/phpstan
    treatPhpDocTypesAsCertain: false
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
